+                        &device_secret,
+                        network,
+                    )
+                    .await
+                    .unwrap()
+            }));
+        }
+        barrier.wait().await;
+        let first = tasks.remove(0).await.unwrap();
+        let second = tasks.remove(0).await.unwrap();
+        assert_eq!(
+            first.write_to_bytes().unwrap(),
+            second.write_to_bytes().unwrap()
+        );
+        assert_eq!(connector.calls.load(Ordering::SeqCst), 2);
+    }
