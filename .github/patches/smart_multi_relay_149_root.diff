+        hbb_common::sodiumoxide::init().unwrap();
+        let connector = Arc::new(ControlledConnector::new(Duration::ZERO));
+        let clock = Arc::new(ManualClock::new());
+        let runtime = runtime(
+            ClientProbeConfig::default(),
+            connector.clone(),
+            clock.clone(),
+        );
+        let (server_public, server_secret) = sign::gen_keypair();
+        let (device_public, device_secret) = sign::gen_keypair();
+        let report = runtime
+            .handle_signed_probe_with_network_observer(
+                signed_request(25, 1, 1_500, &server_secret),
+                &server_public,
+                "requester-a",
+                &device_public,
+                &device_secret,
+                || Ok(network(1)),
+            )
+            .await
+            .unwrap();
+        verify_probe_report_signature(&report, &device_public).unwrap();
+        assert_eq!(connector.calls.load(Ordering::SeqCst), 2);
+
+        let calls = connector.calls.load(Ordering::SeqCst);
+        let mut observations = [Ok(network(2)), Ok(network(3))].into_iter();
+        assert_eq!(
+            runtime
+                .handle_signed_probe_with_network_observer(
+                    signed_request(26, 1, 1_500, &server_secret),
+                    &server_public,
+                    "requester-a",
+                    &device_public,
+                    &device_secret,
+                    || observations.next().unwrap(),
+                )
+                .await,
+            Err(ClientProbeError::NetworkChanged)
+        );
+        assert_eq!(connector.calls.load(Ordering::SeqCst), calls + 2);
+
+        let calls = connector.calls.load(Ordering::SeqCst);
+        let clock_for_observer = clock.clone();
+        let observations = AtomicUsize::new(0);
+        assert_eq!(
+            runtime
+                .handle_signed_probe_with_network_observer(
+                    signed_request(29, 1, 1_500, &server_secret),
+                    &server_public,
+                    "requester-a",
+                    &device_public,
+                    &device_secret,
+                    || {
+                        if observations.fetch_add(1, Ordering::SeqCst) == 1 {
+                            clock_for_observer.advance(1_500);
+                        }
+                        Ok(network(5))
+                    },
+                )
+                .await,
+            Err(ClientProbeError::DeadlineExceeded)
+        );
+        assert_eq!(connector.calls.load(Ordering::SeqCst), calls + 2);
+
+        let (_, wrong_secret) = sign::gen_keypair();
+        let calls = connector.calls.load(Ordering::SeqCst);
+        assert_eq!(
+            runtime
+                .handle_signed_probe_with_network_observer(
+                    signed_request(27, 1, 1_500, &server_secret),
+                    &server_public,
+                    "requester-a",
+                    &device_public,
+                    &wrong_secret,
+                    || Ok(network(4)),
+                )
+                .await,
+            Err(ClientProbeError::ContextMismatch)
+        );
+        assert_eq!(connector.calls.load(Ordering::SeqCst), calls);
+    }
