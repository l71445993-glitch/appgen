+
+    fn verify_response_echo_at(
+        &self,
+        echoed: Option<&SmartRelaySelection>,
+        now_ms: u64,
+    ) -> Result<(), ClientProbeError> {
+        let echoed = echoed.ok_or(ClientProbeError::ContextMismatch)?;
+        verify_selection_signature(echoed, &sign::PublicKey(self.hbbs_public_key))?;
+        if echoed != &self.selection {
+            return Err(ClientProbeError::ContextMismatch);
+        }
+        if now_ms >= self.selection.expires_at_ms {
+            return Err(ClientProbeError::SelectionExpired);
+        }
+        Ok(())
+    }
+}
