+fn random_network_epoch() -> [u8; 16] {
+    let mut epoch = [0_u8; 16];
+    randombytes_into(&mut epoch);
+    epoch
+}
+
+fn validate_probe_recipient(
+    request: &SmartRelayProbeRequest,
+    client_id: &str,
+) -> Result<(), ClientProbeError> {
+    if client_id.is_empty()
+        || client_id.len() > SMART_RELAY_MAX_ID_BYTES
+        || !client_id.is_ascii()
+        || client_id.bytes().any(|byte| !(0x21..=0x7e).contains(&byte))
+    {
+        return Err(ClientProbeError::ContextMismatch);
+    }
+    if request.purpose.value() == SmartRelayProbePurpose::SMART_WARMUP as i32 {
+        return Ok(());
+    }
+    let expected = match request.role.value() {
+        role if role == SmartRelayPeerRole::SMART_REQUESTER as i32 => request.requester_id.as_str(),
+        role if role == SmartRelayPeerRole::SMART_TARGET as i32 => request.target_id.as_str(),
+        _ => return Err(ClientProbeError::ContextMismatch),
+    };
+    if expected == client_id {
+        Ok(())
+    } else {
+        Err(ClientProbeError::ContextMismatch)
+    }
+}
