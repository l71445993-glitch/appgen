+    fn signed_selection(
+        punch_offer: &SmartRelayConnectOffer,
+        server_secret: &sign::SecretKey,
+        expires_at_ms: u64,
+    ) -> SmartRelaySelection {
+        let mut selection = SmartRelaySelection::new();
+        selection.protocol_version = SMART_RELAY_PROTOCOL_V1;
+        selection.requester_id = punch_offer.requester_id.clone();
+        selection.target_id = "target-b".to_owned();
+        selection.node_id = Bytes::copy_from_slice(&[0x55; 16]);
+        selection.relay_server = "1.1.1.1:21117".to_owned();
+        selection.expires_at_ms = expires_at_ms;
+        selection.origin_request_nonce = punch_offer.request_nonce.clone();
+        selection.conn_type = ConnType::TERMINAL.into();
+        selection.mode = SmartRelaySelectionMode::SMART_SELECTION_REAL_BOTH.into();
+        selection.server_signature = Bytes::copy_from_slice(&sign_transcript(
+            &selection_transcript(&selection).unwrap(),
+            server_secret,
+        ));
+        selection
+    }
