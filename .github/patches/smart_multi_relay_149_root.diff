+    static GLOBAL_CONNECT_GATE: OnceLock<Arc<Semaphore>> = OnceLock::new();
+    GLOBAL_CONNECT_GATE
+        .get_or_init(|| Arc::new(Semaphore::new(MAX_GLOBAL_CONNECTS)))
+        .clone()
+}
