+#[derive(Default)]
+struct AttemptAccumulator {
+    samples_us: Vec<u32>,
+    refused: bool,
+    network: bool,
+    invalid_address: bool,
+}
+
+impl AttemptAccumulator {
+    fn record(&mut self, outcome: Result<Duration, AttemptFailure>) {
+        match outcome {
+            Ok(elapsed) => {
+                let micros = u32::try_from(elapsed.as_micros()).unwrap_or(u32::MAX);
+                self.samples_us.push(micros.clamp(1_000, 3_000_000));
+            }
+            Err(AttemptFailure::Refused) => self.refused = true,
+            Err(AttemptFailure::Network) => self.network = true,
+            Err(AttemptFailure::InvalidAddress) => self.invalid_address = true,
+            Err(AttemptFailure::Timeout) => {}
+        }
+    }
+
+    fn sorted_samples(mut self) -> Vec<u32> {
+        self.samples_us.sort_unstable();
+        self.samples_us.truncate(3);
+        self.samples_us
+    }
+
+    fn failure_status(&self) -> SmartRelayProbeStatus {
+        if self.invalid_address {
+            SmartRelayProbeStatus::SMART_PROBE_INVALID_ADDRESS
+        } else if self.refused {
+            SmartRelayProbeStatus::SMART_PROBE_REFUSED
+        } else if self.network {
+            SmartRelayProbeStatus::SMART_PROBE_NETWORK_ERROR
+        } else {
+            SmartRelayProbeStatus::SMART_PROBE_TIMEOUT
+        }
+    }
+}
+
+struct MeasuredCandidates {
+    results: Vec<SmartRelayProbeResult>,
+    cache_updates: Vec<(CacheKey, CachedSuccess)>,
+    finished_at_ms: u64,
+}
+
+struct InflightOwner {
+    state: Arc<Mutex<RuntimeState>>,
+    probe_id: ProbeId,
+    request_digest: [u8; 32],
+    network: NetworkContext,
+    completion: watch::Sender<u64>,
+    active: bool,
+}
+
+impl InflightOwner {
+    fn new(
+        state: Arc<Mutex<RuntimeState>>,
+        probe_id: ProbeId,
+        request_digest: [u8; 32],
+        network: NetworkContext,
+        completion: watch::Sender<u64>,
+    ) -> Self {
+        Self {
+            state,
+            probe_id,
+            request_digest,
+            network,
+            completion,
+            active: true,
+        }
+    }
+
+    fn complete(
+        &mut self,
+        report: SmartRelayProbeReport,
+        now_ms: u64,
+        started: Instant,
+        deadline: Duration,
+        clock: &dyn ProbeClock,
+        issued_at_ms: u64,
+        signed_cutoff_ms: u64,
+    ) -> Result<(), ClientProbeError> {
+        let mut state = self
+            .state
+            .lock()
+            .map_err(|_| ClientProbeError::RuntimeUnavailable)?;
+        ensure_probe_deadline(clock, started, deadline, issued_at_ms, signed_cutoff_ms)?;
+        if state.network_context() != self.network || state.network_signature.is_none() {
+            return Err(ClientProbeError::NetworkChanged);
+        }
+        let owns_entry = state.inflight.get(&self.probe_id).is_some_and(|entry| {
+            entry.request_digest == self.request_digest
+                && entry.network == self.network
+                && entry.completion.same_channel(&self.completion)
+        });
+        if !owns_entry {
+            return Err(ClientProbeError::NetworkChanged);
+        }
+        state.inflight.remove(&self.probe_id);
+        state.completed.insert(
+            self.probe_id,
+            CompletedReport {
+                request_digest: self.request_digest,
+                report,
+                expires_at_ms: now_ms.saturating_add(COMPLETED_REPORT_TTL_MS),
+            },
+        );
+        self.active = false;
+        drop(state);
+        let _ = self.completion.send(1);
+        Ok(())
+    }
+}
+
+impl Drop for InflightOwner {
+    fn drop(&mut self) {
+        if !self.active {
+            return;
+        }
+        if let Ok(mut state) = self.state.lock() {
+            let owns_entry = state.inflight.get(&self.probe_id).is_some_and(|entry| {
+                entry.request_digest == self.request_digest
+                    && entry.completion.same_channel(&self.completion)
+            });
+            if owns_entry {
+                state.inflight.remove(&self.probe_id);
+            }
+        }
+        let _ = self.completion.send(2);
+    }
+}
+
+fn success_result(
+    node_id: [u8; 16],
+    samples_us: Vec<u32>,
+    sample_age_ms: u64,
+) -> SmartRelayProbeResult {
+    let mut result = SmartRelayProbeResult::new();
+    result.node_id = Bytes::copy_from_slice(&node_id);
+    result.status = SmartRelayProbeStatus::SMART_PROBE_OK.into();
+    result.rtt_us = samples_us;
+    result.sample_age_ms = u32::try_from(sample_age_ms.min(STALE_CACHE_MS)).unwrap_or(u32::MAX);
+    result
+}
+
+fn failure_result(node_id: [u8; 16], status: SmartRelayProbeStatus) -> SmartRelayProbeResult {
+    let mut result = SmartRelayProbeResult::new();
+    result.node_id = Bytes::copy_from_slice(&node_id);
+    result.status = status.into();
+    result
+}
