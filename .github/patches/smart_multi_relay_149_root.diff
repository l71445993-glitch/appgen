+}
+
+impl TryFrom<&SmartRelayCandidate> for ParsedCandidate {
+    type Error = ClientProbeError;
+
+    fn try_from(candidate: &SmartRelayCandidate) -> Result<Self, Self::Error> {
+        let node_id = candidate
+            .node_id
+            .as_ref()
+            .try_into()
+            .map_err(|_| ClientProbeError::ContextMismatch)?;
+        let address: [u8; 4] = candidate
+            .address
+            .as_ref()
+            .try_into()
+            .map_err(|_| ClientProbeError::ContextMismatch)?;
+        let port = u16::try_from(candidate.port).map_err(|_| ClientProbeError::ContextMismatch)?;
+        Ok(Self {
+            node_id,
+            endpoint: SocketAddrV4::new(Ipv4Addr::from(address), port),
+            probe_timeout_ms: candidate.probe_timeout_ms,
+            candidate_set_hash: [0; 32],
+        })
+    }
+}
