+    #[tokio::test]
+    async fn signed_probe_cutoff_uses_issue_time_and_rejects_future_clock_without_dial() {
+        let clock = Arc::new(ManualClock::new());
+        let issued_at_ms = clock.wall_time_ms().unwrap();
+        let started = Instant::now();
+        assert!(ensure_probe_deadline(
+            clock.as_ref(),
+            started,
+            Duration::from_millis(1_500),
+            issued_at_ms,
+            issued_at_ms + 1_500,
+        )
+        .is_ok());
+        clock.advance(1_499);
+        assert!(ensure_probe_deadline(
+            clock.as_ref(),
+            started,
+            Duration::from_millis(1_500),
+            issued_at_ms,
+            issued_at_ms + 1_500,
+        )
+        .is_ok());
+
+        hbb_common::sodiumoxide::init().unwrap();
+        let connector = Arc::new(ControlledConnector::new(Duration::ZERO));
+        let runtime = runtime(
+            ClientProbeConfig::default(),
+            connector.clone(),
+            clock.clone(),
+        );
+        let (server_public, server_secret) = sign::gen_keypair();
+        let (_, device_secret) = sign::gen_keypair();
+        let network = observe(&runtime, 1);
+
+        let calls = connector.calls.load(Ordering::SeqCst);
+        clock.advance(1);
+        assert_eq!(
+            runtime
+                .handle_signed_probe(
+                    signed_request(21, 1, 1_500, &server_secret),
+                    &server_public,
+                    "requester-a",
+                    &device_secret,
+                    network,
+                )
+                .await,
+            Err(ClientProbeError::DeadlineExceeded)
+        );
+        assert_eq!(connector.calls.load(Ordering::SeqCst), calls);
+
+        let mut future = signed_request(22, 1, 1_500, &server_secret);
+        future.issued_at_ms = clock.wall_time_ms().unwrap().saturating_add(1);
+        resign_request(&mut future, &server_secret);
+        assert_eq!(
+            runtime
+                .handle_signed_probe(
+                    future,
+                    &server_public,
+                    "requester-a",
+                    &device_secret,
+                    network,
+                )
+                .await,
+            Err(ClientProbeError::DeadlineExceeded)
+        );
+        assert_eq!(connector.calls.load(Ordering::SeqCst), calls);
+    }
