+        self,
+        current_hbbs_public_key: &[u8],
+    ) -> Result<SmartRelaySelection, ClientProbeError> {
+        self.into_local_addr_echo_at(current_hbbs_public_key, current_wall_time_ms()?)
+    }
+
+    fn into_local_addr_echo_at(
+        self,
+        current_hbbs_public_key: &[u8],
+        now_ms: u64,
+    ) -> Result<SmartRelaySelection, ClientProbeError> {
+        if self.envelope != TargetInitialEnvelope::FetchLocalAddr {
+            return Err(ClientProbeError::ContextMismatch);
+        }
+        self.selection
+            .into_response_echo_at(current_hbbs_public_key, now_ms)
+    }
+
+    pub(crate) fn into_relay_selection(self) -> VerifiedTargetRelaySelection {
+        self.selection
+    }
+}
+
+/// Validates the hbbs-signed selection delivered to the target in an initial
+/// PunchHole or FetchLocalAddr envelope. Those upstream envelopes do not carry
+/// requester ID, connection type, or origin nonce outside the signed
+/// selection, so the target binds the independently available outer context:
+/// its configured device ID and the singular relay endpoint.
+pub(crate) fn verify_target_initial_selection(
+    hbbs_public_key: &[u8],
+    target_id: &str,
+    outer_relay_server: &str,
+    envelope: TargetInitialEnvelope,
+    selection: Option<&SmartRelaySelection>,
+) -> Result<Option<VerifiedTargetInitialSelection>, ClientProbeError> {
+    let Some(selection) = selection else {
+        return Ok(None);
+    };
+    verify_target_initial_selection_at(
+        hbbs_public_key,
+        target_id,
+        outer_relay_server,
+        envelope,
+        selection,
+        current_wall_time_ms()?,
+    )
+    .map(Some)
+}
+
+fn verify_target_initial_selection_at(
+    hbbs_public_key: &[u8],
+    target_id: &str,
+    outer_relay_server: &str,
+    envelope: TargetInitialEnvelope,
+    selection: &SmartRelaySelection,
+    now_ms: u64,
+) -> Result<VerifiedTargetInitialSelection, ClientProbeError> {
+    hbb_common::sodiumoxide::init().map_err(|_| ClientProbeError::RuntimeUnavailable)?;
+    let hbbs_public_key = sign::PublicKey::from_slice(hbbs_public_key)
+        .ok_or(SmartRelayWireError::InvalidLength("hbbs public key"))?;
+    verify_selection_signature(selection, &hbbs_public_key)?;
+    if selection.requester_id.is_empty()
+        || target_id.is_empty()
+        || selection.target_id != target_id
+        || selection.relay_server != outer_relay_server
+    {
+        return Err(ClientProbeError::ContextMismatch);
+    }
+    if now_ms >= selection.expires_at_ms
+        || selection.expires_at_ms.saturating_sub(now_ms) > SMART_RELAY_SELECTION_TTL_MS
+    {
+        return Err(ClientProbeError::SelectionExpired);
+    }
+    let selection_digest: [u8; 32] = Sha256::digest(selection_transcript(selection)?).into();
+    let origin_request_nonce = selection
+        .origin_request_nonce
+        .as_ref()
+        .try_into()
+        .map_err(|_| ClientProbeError::ContextMismatch)?;
+    Ok(VerifiedTargetInitialSelection {
+        selection: VerifiedTargetRelaySelection {
+            selection: selection.clone(),
+            hbbs_public_key: hbbs_public_key.0,
+            hard_deadline_ms: selection.expires_at_ms,
+            relay_attempt: None,
+        },
+        envelope,
+        dedupe_key: TargetInitialDedupeKey {
+            envelope,
+            requester_id: selection.requester_id.clone(),
+            target_id: selection.target_id.clone(),
+            origin_request_nonce,
+        },
+        context_digest: selection_digest,
+    })
+}
+
+/// Validates the hbbs-signed target selection after delivery on the existing
+/// authenticated hbbs connection. The requester public key is deliberately
+/// not present in RequestRelay, so the target does not claim to repeat hbbs'
+/// earlier requester-signature check.
+pub(crate) fn verify_target_relay_selection(
+    hbbs_public_key: &[u8],
+    target_id: &str,
+    request: &RequestRelay,
+) -> Result<Option<VerifiedTargetRelaySelection>, ClientProbeError> {
+    let Some(offer) = request.smart_relay.as_ref() else {
+        return Ok(None);
+    };
+    let verified = verify_target_relay_selection_at(
+        hbbs_public_key,
+        target_id,
+        request,
+        offer,
+        current_wall_time_ms()?,
+    )?;
+    validate_target_relay_request_time(offer, &verified.selection, current_wall_time_ms()?)?;
+    Ok(Some(verified))
+}
+
+fn verify_target_relay_selection_at(
+    hbbs_public_key: &[u8],
+    target_id: &str,
+    request: &RequestRelay,
+    offer: &SmartRelayConnectOffer,
+    now_ms: u64,
+) -> Result<VerifiedTargetRelaySelection, ClientProbeError> {
+    hbb_common::sodiumoxide::init().map_err(|_| ClientProbeError::RuntimeUnavailable)?;
+    let hbbs_public_key = sign::PublicKey::from_slice(hbbs_public_key)
+        .ok_or(SmartRelayWireError::InvalidLength("hbbs public key"))?;
+    if request.id != target_id || offer.signature.len() != 64 {
+        return Err(ClientProbeError::ContextMismatch);
+    }
+    let context = RelayConnectTranscriptContext {
+        hbbs_key_fingerprint: &hbbs_key_fingerprint(hbbs_public_key.as_ref())?,
+        requester_id: &offer.requester_id,
+        target_id,
+        conn_type: request
+            .conn_type
+            .enum_value()
+            .map_err(|_| SmartRelayWireError::InvalidEnum("RequestRelay connection type"))?,
+        secure: request.secure,
+        relay_attempt_uuid: &request.uuid,
+        relay_server: &request.relay_server,
+    };
+    let relay_transcript = relay_connect_transcript(context, offer)?;
+    let selection = offer
+        .selection
+        .as_ref()
+        .cloned()
+        .ok_or(ClientProbeError::ContextMismatch)?;
+    verify_selection_signature(&selection, &hbbs_public_key)?;
+    let hard_deadline_ms = validate_target_relay_request_time(offer, &selection, now_ms)?;
+    Ok(VerifiedTargetRelaySelection {
+        selection,
+        hbbs_public_key: hbbs_public_key.0,
+        hard_deadline_ms,
+        relay_attempt: Some(TargetRelayAttemptContext {
+            key: TargetRelayAttemptKey {
+                requester_id: offer.requester_id.clone(),
+                target_id: target_id.to_owned(),
+                origin_request_nonce: offer
+                    .request_nonce
+                    .as_ref()
+                    .try_into()
+                    .map_err(|_| ClientProbeError::ContextMismatch)?,
+                relay_attempt_uuid: request.uuid.clone(),
+            },
+            digest: Sha256::digest(relay_transcript).into(),
+        }),
+    })
+}
+
+fn validate_target_relay_request_time(
+    offer: &SmartRelayConnectOffer,
+    selection: &SmartRelaySelection,
+    now_ms: u64,
+) -> Result<u64, ClientProbeError> {
+    let attempt_deadline_ms = offer
+        .issued_at_ms
+        .checked_add(SMART_RELAY_RELAY_ATTEMPT_TTL_MS)
+        .ok_or(ClientProbeError::SelectionExpired)?;
+    let hard_deadline_ms = attempt_deadline_ms.min(selection.expires_at_ms);
+    if now_ms < offer.issued_at_ms || now_ms >= hard_deadline_ms {
+        Err(ClientProbeError::SelectionExpired)
+    } else {
+        Ok(hard_deadline_ms)
+    }
+}
+
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn verify_punch_selection(
+    hbbs_public_key: &[u8],
+    device_public_key: &[u8],
+    punch_offer: &SmartRelayConnectOffer,
+    target_id: &str,
+    conn_type: ConnType,
+    force_relay: bool,
+    outer_relay_server: &str,
+    selection: SmartRelaySelection,
+) -> Result<VerifiedSmartRelaySelection, ClientProbeError> {
+    let verified = verify_punch_selection_at(
+        hbbs_public_key,
+        device_public_key,
+        punch_offer,
+        target_id,
+        conn_type,
+        force_relay,
+        outer_relay_server,
+        selection,
+        current_wall_time_ms()?,
+    )?;
+    if current_wall_time_ms()? >= verified.selection.expires_at_ms {
+        return Err(ClientProbeError::SelectionExpired);
+    }
+    Ok(verified)
+}
+
+#[allow(clippy::too_many_arguments)]
+fn verify_punch_selection_at(
+    hbbs_public_key: &[u8],
+    device_public_key: &[u8],
+    punch_offer: &SmartRelayConnectOffer,
+    target_id: &str,
+    conn_type: ConnType,
+    force_relay: bool,
+    outer_relay_server: &str,
+    selection: SmartRelaySelection,
+    now_ms: u64,
+) -> Result<VerifiedSmartRelaySelection, ClientProbeError> {
+    let hbbs_public_key = sign::PublicKey::from_slice(hbbs_public_key)
+        .ok_or(SmartRelayWireError::InvalidLength("hbbs public key"))?;
+    let device_public_key = sign::PublicKey::from_slice(device_public_key)
+        .ok_or(SmartRelayWireError::InvalidLength("device public key"))?;
+    let fingerprint = hbbs_key_fingerprint(hbbs_public_key.as_ref())?;
+    verify_punch_connect_signature(
+        PunchConnectTranscriptContext {
+            hbbs_key_fingerprint: &fingerprint,
+            requester_id: &punch_offer.requester_id,
+            target_id,
+            conn_type,
+            force_relay,
+        },
+        punch_offer,
+        &device_public_key,
+    )?;
+    verify_selection_signature(&selection, &hbbs_public_key)?;
+    if selection.requester_id != punch_offer.requester_id
+        || selection.target_id != target_id
+        || selection.origin_request_nonce.as_ref() != punch_offer.request_nonce.as_ref()
+        || selection.conn_type.value() != conn_type as i32
+        || selection.relay_server != outer_relay_server
+    {
+        return Err(ClientProbeError::ContextMismatch);
+    }
+    if now_ms < punch_offer.issued_at_ms
+        || now_ms.saturating_sub(punch_offer.issued_at_ms) > SMART_RELAY_SELECTION_TTL_MS
+        || selection.expires_at_ms <= now_ms
+        || selection.expires_at_ms.saturating_sub(now_ms) > SMART_RELAY_SELECTION_TTL_MS
+    {
+        return Err(ClientProbeError::SelectionExpired);
+    }
+    Ok(VerifiedSmartRelaySelection {
+        selection,
+        hbbs_public_key: hbbs_public_key.0,
+        device_public_key: device_public_key.0,
+    })
+}
+
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn signed_relay_connect_offer(
+    verified: &VerifiedSmartRelaySelection,
+    target_id: &str,
+    conn_type: ConnType,
+    secure: bool,
+    relay_attempt_uuid: &str,
+    relay_server: &str,
+    device_public_key: &[u8],
+    device_secret_key: &[u8],
+) -> Result<SmartRelayConnectOffer, ClientProbeError> {
+    let offer = signed_relay_connect_offer_at(
+        verified,
+        target_id,
+        conn_type,
+        secure,
+        relay_attempt_uuid,
+        relay_server,
+        device_public_key,
+        device_secret_key,
+        current_wall_time_ms()?,
+    )?;
+    if current_wall_time_ms()? >= verified.selection.expires_at_ms {
+        return Err(ClientProbeError::SelectionExpired);
+    }
+    Ok(offer)
+}
+
+#[allow(clippy::too_many_arguments)]
+fn signed_relay_connect_offer_at(
+    verified: &VerifiedSmartRelaySelection,
+    target_id: &str,
+    conn_type: ConnType,
+    secure: bool,
+    relay_attempt_uuid: &str,
+    relay_server: &str,
+    device_public_key: &[u8],
+    device_secret_key: &[u8],
+    now_ms: u64,
+) -> Result<SmartRelayConnectOffer, ClientProbeError> {
+    if now_ms >= verified.selection.expires_at_ms {
+        return Err(ClientProbeError::SelectionExpired);
+    }
+    hbb_common::sodiumoxide::init().map_err(|_| ClientProbeError::RuntimeUnavailable)?;
+    let device_public_key = sign::PublicKey::from_slice(device_public_key)
+        .ok_or(SmartRelayWireError::InvalidLength("device public key"))?;
+    if device_public_key.0 != verified.device_public_key {
+        return Err(ClientProbeError::ContextMismatch);
+    }
+    let device_secret_key = sign::SecretKey::from_slice(device_secret_key)
+        .ok_or(SmartRelayWireError::InvalidLength("device secret key"))?;
+    let fingerprint = hbbs_key_fingerprint(&verified.hbbs_public_key)?;
+    let context = RelayConnectTranscriptContext {
+        hbbs_key_fingerprint: &fingerprint,
+        requester_id: &verified.selection.requester_id,
+        target_id,
+        conn_type,
+        secure,
+        relay_attempt_uuid,
+        relay_server,
+    };
+    let mut offer = SmartRelayConnectOffer::new();
+    offer.protocol_version = SMART_RELAY_PROTOCOL_V1;
+    offer.requester_id = verified.selection.requester_id.clone();
+    offer.request_nonce = verified.selection.origin_request_nonce.clone();
+    offer.issued_at_ms = now_ms;
+    offer.selection = hbb_common::protobuf::MessageField::some(verified.selection.clone());
+    let transcript = relay_connect_transcript(context, &offer)?;
+    offer.signature = Bytes::copy_from_slice(&sign_transcript(&transcript, &device_secret_key));
+    verify_relay_connect_signatures(
+        context,
+        &offer,
+        &device_public_key,
+        &sign::PublicKey(verified.hbbs_public_key),
+    )?;
+    Ok(offer)
+}
+
+fn signed_process_capability(
+    hbbs_public_key: &[u8],
+    peer_id: &str,
+    register_pk_public_key: Option<&[u8]>,
+    device_secret_key: &sign::SecretKey,
+) -> Result<SmartRelayCapability, ClientProbeError> {
+    hbb_common::sodiumoxide::init().map_err(|_| ClientProbeError::RuntimeUnavailable)?;
+    let identity = process_capability_identity()?;
+    let fingerprint = hbbs_key_fingerprint(hbbs_public_key)?;
+    let mut capability = SmartRelayCapability::new();
+    capability.min_protocol = SMART_RELAY_PROTOCOL_V1;
+    capability.max_protocol = SMART_RELAY_PROTOCOL_V1;
+    capability.feature_bits =
+        SMART_RELAY_REQUIRED_SESSION_FEATURES | SMART_RELAY_FEATURE_NETWORK_EPOCH_CACHE;
+    capability.max_candidates = SMART_RELAY_MAX_CANDIDATES as u32;
+    capability.client_nonce = Bytes::copy_from_slice(&identity.nonce);
+    capability.issued_at_ms = identity.issued_at_ms;
+    let context = CapabilityTranscriptContext {
+        hbbs_key_fingerprint: &fingerprint,
+        outer_peer_id: peer_id,
+        register_pk_public_key,
+    };
+    let transcript = capability_transcript(context, &capability)?;
+    capability.signature = Bytes::copy_from_slice(&sign_transcript(&transcript, device_secret_key));
+    if let Some(public_key) = register_pk_public_key {
+        let public_key = sign::PublicKey::from_slice(public_key)
+            .ok_or(SmartRelayWireError::InvalidLength("RegisterPk public key"))?;
+        verify_transcript(&transcript, &capability.signature, &public_key)?;
+    }
+    Ok(capability)
+}
+
+fn process_capability_identity() -> Result<ProcessCapabilityIdentity, ClientProbeError> {
+    if let Some(identity) = PROCESS_CAPABILITY_IDENTITY.get() {
+        return Ok(*identity);
+    }
+    let mut nonce = [0; 16];
+    randombytes_into(&mut nonce);
+    let identity = ProcessCapabilityIdentity {
+        nonce,
+        issued_at_ms: current_wall_time_ms()?,
+    };
+    Ok(*PROCESS_CAPABILITY_IDENTITY.get_or_init(|| identity))
+}
+
+fn current_wall_time_ms() -> Result<u64, ClientProbeError> {
+    let elapsed = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_err(|_| ClientProbeError::InvalidSystemClock)?;
+    u64::try_from(elapsed.as_millis()).map_err(|_| ClientProbeError::InvalidSystemClock)
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+struct NetworkSignatureDigest([u8; 32]);
+
+impl NetworkSignatureDigest {
+    /// The platform adapter must convert its normalized route/interface
+    /// observation to a domain-separated opaque digest before crossing this
+    /// boundary. Raw SSIDs, BSSIDs, MACs, local addresses, and public IPs are
+    /// never accepted by this runtime.
+    fn from_opaque_digest(digest: [u8; 32]) -> Self {
+        Self(digest)
+    }
+}
+
+struct NetworkObservation {
+    interface_index: u32,
+    ipv4_prefixes: Vec<(Ipv4Addr, u8)>,
+    ipv6_prefixes: Vec<(Ipv6Addr, u8)>,
+    gateway: Option<IpAddr>,
+}
+
+fn current_network_signature() -> Result<NetworkSignatureDigest, ClientProbeError> {
+    let interface =
+        default_net::get_default_interface().map_err(|_| ClientProbeError::NetworkUnavailable)?;
+    network_signature(&NetworkObservation {
+        interface_index: interface.index,
+        ipv4_prefixes: interface
+            .ipv4
+            .into_iter()
+            .map(|network| (network.addr, network.prefix_len))
+            .collect(),
+        ipv6_prefixes: interface
+            .ipv6
+            .into_iter()
+            .map(|network| (network.addr, network.prefix_len))
+            .collect(),
+        gateway: interface.gateway.map(|gateway| gateway.ip_addr),
+    })
+}
+
+fn network_signature(
+    observation: &NetworkObservation,
+) -> Result<NetworkSignatureDigest, ClientProbeError> {
+    let mut ipv4_prefixes = observation
+        .ipv4_prefixes
+        .iter()
+        .map(|(address, prefix)| {
+            if *prefix > 32 {
+                return Err(ClientProbeError::NetworkUnavailable);
+            }
+            let mask = u32::MAX.checked_shl(u32::from(32 - *prefix)).unwrap_or(0);
+            Ok((u32::from(*address) & mask, *prefix))
+        })
+        .collect::<Result<Vec<_>, ClientProbeError>>()?;
+    ipv4_prefixes.sort_unstable();
+    ipv4_prefixes.dedup();
+
+    let mut ipv6_prefixes = observation
+        .ipv6_prefixes
+        .iter()
+        .map(|(address, prefix)| {
+            if *prefix > 128 {
+                return Err(ClientProbeError::NetworkUnavailable);
+            }
+            let mask = u128::MAX.checked_shl(u32::from(128 - *prefix)).unwrap_or(0);
+            Ok((u128::from(*address) & mask, *prefix))
+        })
+        .collect::<Result<Vec<_>, ClientProbeError>>()?;
+    ipv6_prefixes.sort_unstable();
+    ipv6_prefixes.dedup();
+
+    let mut canonical = Vec::with_capacity(128);
+    canonical.extend_from_slice(b"RDSMART/CLIENT-NETWORK-SIGNATURE/V1\0");
+    canonical.extend_from_slice(&observation.interface_index.to_be_bytes());
+    canonical.extend_from_slice(
+        &u32::try_from(ipv4_prefixes.len())
+            .map_err(|_| ClientProbeError::NetworkUnavailable)?
+            .to_be_bytes(),
+    );
+    for (network, prefix) in ipv4_prefixes {
+        canonical.extend_from_slice(&network.to_be_bytes());
+        canonical.push(prefix);
+    }
+    canonical.extend_from_slice(
+        &u32::try_from(ipv6_prefixes.len())
+            .map_err(|_| ClientProbeError::NetworkUnavailable)?
+            .to_be_bytes(),
+    );
+    for (network, prefix) in ipv6_prefixes {
+        canonical.extend_from_slice(&network.to_be_bytes());
+        canonical.push(prefix);
+    }
+    match observation.gateway {
+        None => canonical.push(0),
+        Some(IpAddr::V4(address)) => {
+            canonical.push(4);
+            canonical.extend_from_slice(&address.octets());
+        }
+        Some(IpAddr::V6(address)) => {
+            canonical.push(6);
+            canonical.extend_from_slice(&address.octets());
+        }
+    }
+    Ok(NetworkSignatureDigest(Sha256::digest(canonical).into()))
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+struct NetworkContext {
+    generation: u64,
+    epoch: [u8; 16],
+}
