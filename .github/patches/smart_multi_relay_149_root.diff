+pub(crate) fn signed_register_pk_capability(
+    hbbs_public_key: &[u8],
+    peer_id: &str,
+    outer_public_key: &[u8],
+    device_secret_key: &sign::SecretKey,
+) -> Result<SmartRelayCapability, ClientProbeError> {
+    signed_process_capability(
+        hbbs_public_key,
+        peer_id,
+        Some(outer_public_key),
+        device_secret_key,
