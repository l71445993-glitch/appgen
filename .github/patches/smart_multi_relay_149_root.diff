+    #[tokio::test]
+    async fn async_probe_and_joiner_recheck_wall_cutoff_and_rollback() {
+        hbb_common::sodiumoxide::init().unwrap();
+        let connector = Arc::new(GatedConnector::new());
+        let clock = Arc::new(ManualClock::new());
+        let runtime = Arc::new(runtime(
+            ClientProbeConfig::default(),
+            connector.clone(),
+            clock.clone(),
+        ));
+        let (server_public, server_secret) = sign::gen_keypair();
+        let (_, device_secret) = sign::gen_keypair();
+        let network = observe(&runtime, 1);
+        let request = signed_request(23, 1, 1_500, &server_secret);
+
+        let owner_runtime = runtime.clone();
+        let owner_request = request.clone();
+        let owner_public = server_public;
+        let owner_secret = device_secret.clone();
+        let owner = tokio::spawn(async move {
+            owner_runtime
+                .handle_signed_probe(
+                    owner_request,
+                    &owner_public,
+                    "requester-a",
+                    &owner_secret,
+                    network,
+                )
+                .await
+        });
+        timeout(Duration::from_secs(1), connector.wait_until_entered())
+            .await
+            .unwrap();
+        let join_runtime = runtime.clone();
+        let join_public = server_public;
+        let join_secret = device_secret.clone();
+        let joiner = tokio::spawn(async move {
+            join_runtime
+                .handle_signed_probe(request, &join_public, "requester-a", &join_secret, network)
+                .await
+        });
+        timeout(Duration::from_secs(1), async {
+            loop {
+                let subscribed = runtime
+                    .state
+                    .lock()
+                    .unwrap()
+                    .inflight
+                    .values()
+                    .next()
+                    .is_some_and(|inflight| inflight.completion.receiver_count() >= 2);
+                if subscribed {
+                    break;
+                }
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .unwrap();
+        clock.advance(1_500);
+        connector.release();
+        assert_eq!(
+            owner.await.unwrap(),
+            Err(ClientProbeError::DeadlineExceeded)
+        );
+        assert_eq!(
+            joiner.await.unwrap(),
+            Err(ClientProbeError::DeadlineExceeded)
+        );
+        assert!(runtime.state.lock().unwrap().completed.is_empty());
+
+        let rollback_connector = Arc::new(GatedConnector::new());
+        let rollback_clock = Arc::new(ManualClock::new());
+        let rollback_runtime = Arc::new(self::runtime(
+            ClientProbeConfig::default(),
+            rollback_connector.clone(),
+            rollback_clock.clone(),
+        ));
+        let rollback_network = observe(&rollback_runtime, 2);
+        let rollback_task = {
+            let runtime = rollback_runtime.clone();
+            let public = server_public;
+            let secret = device_secret;
+            tokio::spawn(async move {
+                runtime
+                    .handle_signed_probe(
+                        signed_request(24, 1, 1_500, &server_secret),
+                        &public,
+                        "requester-a",
+                        &secret,
+                        rollback_network,
+                    )
+                    .await
+            })
+        };
+        timeout(
+            Duration::from_secs(1),
+            rollback_connector.wait_until_entered(),
+        )
+        .await
+        .unwrap();
+        rollback_clock.set_wall(1_786_543_199_999);
+        rollback_connector.release();
+        assert_eq!(
+            rollback_task.await.unwrap(),
+            Err(ClientProbeError::DeadlineExceeded)
+        );
+        assert!(rollback_runtime.state.lock().unwrap().completed.is_empty());
+    }
