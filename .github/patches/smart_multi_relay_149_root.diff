+fn registration_capability(
+    peer_id: &str,
+    device_public_key: &[u8],
+    register_pk: bool,
+) -> Option<SmartRelayCapability> {
+    let mut hbbs_key = Config::get_option("key");
+    if hbbs_key.is_empty() {
+        hbbs_key = config::RS_PUB_KEY.to_owned();
+    }
+    let hbbs_public_key = crate::get_rs_pk(&hbbs_key)?;
+    let (device_secret_key, configured_public_key) = Config::get_key_pair();
+    if configured_public_key != device_public_key {
+        log::warn!("smart relay capability omitted: device key changed during registration");
+        return None;
+    }
+    match signed_registration_capability(
+        hbbs_public_key.as_ref(),
+        peer_id,
+        device_public_key,
+        &device_secret_key,
+        register_pk,
+    ) {
+        Ok(capability) => Some(capability),
+        Err(error) => {
+            log::warn!("smart relay capability omitted: {error}");
+            None
+        }
+    }
+}
+
+fn configured_hbbs_public_key() -> Option<hbb_common::sodiumoxide::crypto::sign::PublicKey> {
+    let mut hbbs_key = Config::get_option("key");
+    if hbbs_key.is_empty() {
+        hbbs_key = config::RS_PUB_KEY.to_owned();
+    }
+    crate::get_rs_pk(&hbbs_key)
+}
+
+fn current_configured_hbbs_public_key(
+) -> ResultType<hbb_common::sodiumoxide::crypto::sign::PublicKey> {
+    configured_hbbs_public_key()
+        .ok_or_else(|| anyhow::anyhow!("configured hbbs public key is invalid"))
+}
+
+fn verified_target_initial_selection(
+    outer_relay_server: &str,
+    envelope: TargetInitialEnvelope,
+    selection: Option<&SmartRelaySelection>,
+) -> ResultType<Option<VerifiedTargetInitialSelection>> {
+    if selection.is_none() {
+        return Ok(None);
+    }
+    let hbbs_public_key = current_configured_hbbs_public_key()?;
+    Ok(verify_target_initial_selection(
+        hbbs_public_key.as_ref(),
+        &Config::get_id(),
+        outer_relay_server,
+        envelope,
+        selection,
+    )?)
+}
+
+enum TargetInitialAdmission {
+    Owner(Option<AttemptLease<TargetInitialDedupeKey>>),
+    Duplicate,
+}
+
+async fn reserve_target_initial(
+    requester_addr: SocketAddr,
+    smart_selection: Option<&VerifiedTargetInitialSelection>,
+) -> ResultType<TargetInitialAdmission> {
+    if let Some(selection) = smart_selection {
+        let (key, digest) = selection.dedupe_context();
+        return match reserve_attempt(&SMART_INITIAL_ATTEMPTS, key, digest, Instant::now()) {
+            Ok(AttemptReservation::Owner(lease)) => Ok(TargetInitialAdmission::Owner(Some(lease))),
+            Ok(AttemptReservation::Duplicate) => Ok(TargetInitialAdmission::Duplicate),
+            Err(AttemptReservationError::ContextMismatch) => {
+                bail!("smart initial retry context mismatch")
+            }
+            Err(AttemptReservationError::CapacityExhausted) => {
+                bail!("smart initial retry capacity exhausted")
+            }
+            Err(AttemptReservationError::Unavailable) => {
+                bail!("smart initial retry coordinator unavailable")
+            }
+        };
+    }
+    let last = *LAST_MSG.lock().await;
+    *LAST_MSG.lock().await = (requester_addr, Instant::now());
+    if should_suppress_ordinary_initial(last.0, requester_addr, last.1.elapsed()) {
+        Ok(TargetInitialAdmission::Duplicate)
+    } else {
+        Ok(TargetInitialAdmission::Owner(None))
+    }
+}
+
+fn should_suppress_ordinary_initial(
+    previous_addr: SocketAddr,
+    current_addr: SocketAddr,
+    elapsed: Duration,
+) -> bool {
+    previous_addr == current_addr && elapsed.as_millis() < 100
+}
+
+fn select_target_relay_server(
+    smart_relay_server: Option<&str>,
+    official_relay_server: impl FnOnce() -> String,
+) -> String {
+    smart_relay_server
+        .map(str::to_owned)
+        .unwrap_or_else(official_relay_server)
+}
+
+fn attach_punch_hole_selection(response: &mut PunchHoleSent, selection: SmartRelaySelection) {
+    response.smart_relay = hbb_common::protobuf::MessageField::some(selection);
+}
+
+fn finalize_punch_hole_sent(
+    mut response: PunchHoleSent,
+    smart_selection: Option<VerifiedTargetInitialSelection>,
+) -> ResultType<PunchHoleSent> {
+    if let Some(selection) = smart_selection {
+        attach_punch_hole_selection(
+            &mut response,
+            selection.into_punch_hole_echo(current_configured_hbbs_public_key()?.as_ref())?,
+        );
+    }
+    Ok(response)
+}
+
+fn punch_hole_sent_bytes(
+    response: &PunchHoleSent,
+    smart_selection: Option<&VerifiedTargetInitialSelection>,
+) -> ResultType<Vec<u8>> {
+    let mut message = Message::new();
+    message.set_punch_hole_sent(finalize_punch_hole_sent(
+        response.clone(),
+        smart_selection.cloned(),
+    )?);
+    Ok(message.write_to_bytes()?)
+}
+
+#[cfg(test)]
+fn punch_hole_sent_bytes_at(
+    response: &PunchHoleSent,
+    smart_selection: &VerifiedTargetInitialSelection,
+    hbbs_public_key: &[u8],
+    now_ms: u64,
+) -> ResultType<Vec<u8>> {
+    let mut response = response.clone();
+    attach_punch_hole_selection(
+        &mut response,
+        smart_selection
+            .clone()
+            .into_punch_hole_echo_at(hbbs_public_key, now_ms)?,
+    );
+    let mut message = Message::new();
+    message.set_punch_hole_sent(response);
+    Ok(message.write_to_bytes()?)
+}
+
+fn attach_local_addr_selection(response: &mut LocalAddr, selection: SmartRelaySelection) {
+    response.smart_relay = hbb_common::protobuf::MessageField::some(selection);
+}
+
+fn target_relay_response(
+    socket_addr: bytes::Bytes,
+    socket_addr_v6: bytes::Bytes,
+    version: &str,
+    uuid: &str,
+    relay_server: &str,
+    initiate_id: Option<String>,
+    smart_selection: Option<SmartRelaySelection>,
+) -> RelayResponse {
+    let mut response = RelayResponse {
+        socket_addr,
+        version: version.to_owned(),
+        socket_addr_v6,
+        ..Default::default()
+    };
+    if smart_selection.is_some() || initiate_id.is_some() {
+        response.uuid = uuid.to_owned();
+        response.relay_server = relay_server.to_owned();
+    }
+    if let Some(id) = initiate_id {
+        response.set_id(id);
+    }
+    if let Some(selection) = smart_selection {
+        response.smart_relay = hbb_common::protobuf::MessageField::some(selection);
+    }
+    response
+}
+
+fn target_transport_requires_relay(
+    use_websocket: bool,
+    use_proxy: bool,
+    force_relay: bool,
+) -> bool {
+    use_websocket || use_proxy || force_relay
+}
+
+fn target_punch_requires_immediate_relay(
+    peer_is_symmetric: bool,
+    target_is_symmetric: bool,
+    transport_requires_relay: bool,
+    tcp_listen_disabled: bool,
+    requester_udp_port: i32,
+) -> bool {
+    peer_is_symmetric
+        || target_is_symmetric
+        || transport_requires_relay
+        || (tcp_listen_disabled && requester_udp_port <= 0)
+}
+
+fn rendezvous_stream_origin(
+    application_secured: bool,
+    strict_websocket_tls_handshake: bool,
+    insecure_tls_fallback: bool,
+) -> RendezvousMessageOrigin {
+    if application_secured || (strict_websocket_tls_handshake && !insecure_tls_fallback) {
+        RendezvousMessageOrigin::AuthenticatedStream
+    } else {
+        RendezvousMessageOrigin::UnauthenticatedStream
+    }
+}
+
+fn should_suppress_relay_request(
+    is_smart: bool,
+    previous_addr: SocketAddr,
+    current_addr: SocketAddr,
+    elapsed: Duration,
+) -> bool {
+    !is_smart && previous_addr == current_addr && elapsed.as_millis() < 100
+}
