+        Ok(AttemptReservation::Owner(lease)) => Ok(Some(TargetResponseAttemptLease::Relay(lease))),
+        Ok(AttemptReservation::Duplicate) => Ok(None),
+        Err(AttemptReservationError::ContextMismatch) => {
+            bail!("smart relay retry context mismatch")
+        }
+        Err(AttemptReservationError::CapacityExhausted) => {
+            bail!("smart relay retry capacity exhausted")
+        }
+        Err(AttemptReservationError::Unavailable) => {
+            bail!("smart relay retry coordinator unavailable")
+        }
+    }
+}
