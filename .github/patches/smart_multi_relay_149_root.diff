+async fn handle_configured_smart_relay_probe_request(
+    request: SmartRelayProbeRequest,
+) -> Result<SmartRelayProbeReport, ClientProbeError> {
+    let mut hbbs_key = Config::get_option("key");
+    if hbbs_key.is_empty() {
+        hbbs_key = config::RS_PUB_KEY.to_owned();
+    }
+    let hbbs_public_key = crate::get_rs_pk(&hbbs_key).ok_or(ClientProbeError::ContextMismatch)?;
+    let (device_secret_key, device_public_key) = Config::get_key_pair();
+    let device_secret_key =
+        sign::SecretKey::from_slice(&device_secret_key).ok_or(ClientProbeError::ContextMismatch)?;
+    let device_public_key =
+        sign::PublicKey::from_slice(&device_public_key).ok_or(ClientProbeError::ContextMismatch)?;
+    if device_secret_key.public_key() != device_public_key {
+        return Err(ClientProbeError::ContextMismatch);
+    }
+    let client_id = Config::get_id();
+    let runtime = smart_relay_probe_runtime()?;
+    let pending_report = runtime
+        .handle_signed_probe_on_current_network(
+            request,
+            &hbbs_public_key,
+            &client_id,
+            &device_public_key,
+            &device_secret_key,
+        )
+        .await?;
+    let report = runtime.finalize_probe_report_delivery(pending_report)?;
+
+    let mut current_hbbs_key = Config::get_option("key");
+    if current_hbbs_key.is_empty() {
+        current_hbbs_key = config::RS_PUB_KEY.to_owned();
+    }
+    let current_hbbs_public_key =
+        crate::get_rs_pk(&current_hbbs_key).ok_or(ClientProbeError::ContextMismatch)?;
+    let (_, current_device_public_key) = Config::get_key_pair();
+    if current_hbbs_public_key != hbbs_public_key
+        || current_device_public_key.as_slice() != device_public_key.as_ref()
+        || Config::get_id() != client_id
+    {
+        return Err(ClientProbeError::ContextMismatch);
+    }
+    Ok(report)
+}
