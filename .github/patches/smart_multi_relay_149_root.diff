+#[derive(Debug, PartialEq, Eq)]
+enum AttemptReservationError {
+    ContextMismatch,
+    CapacityExhausted,
+    Unavailable,
+}
+
+struct AttemptLease<K: Eq + std::hash::Hash + Clone> {
+    registry: Arc<StdMutex<BoundedAttemptRegistry<K>>>,
+    key: K,
+    context_digest: [u8; 32],
+    active: bool,
+}
+
+impl<K: Eq + std::hash::Hash + Clone> AttemptLease<K> {
+    fn complete(&mut self, now: Instant) -> Result<(), AttemptReservationError> {
+        let mut registry = self
+            .registry
+            .lock()
+            .map_err(|_| AttemptReservationError::Unavailable)?;
+        let completed_ttl = registry.completed_ttl;
+        let Some(entry) = registry.entries.get_mut(&self.key) else {
+            return Err(AttemptReservationError::Unavailable);
+        };
+        if entry.context_digest != self.context_digest || entry.completed_until.is_some() {
+            return Err(AttemptReservationError::ContextMismatch);
+        }
+        entry.completed_until = Some(now + completed_ttl);
+        self.active = false;
+        Ok(())
+    }
+}
+
+impl<K: Eq + std::hash::Hash + Clone> Drop for AttemptLease<K> {
+    fn drop(&mut self) {
+        if !self.active {
+            return;
+        }
+        if let Ok(mut registry) = self.registry.lock() {
+            let owns_entry = registry.entries.get(&self.key).is_some_and(|entry| {
+                entry.context_digest == self.context_digest && entry.completed_until.is_none()
+            });
+            if owns_entry {
+                registry.entries.remove(&self.key);
+            }
+        }
+    }
+}
