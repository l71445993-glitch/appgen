+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) enum ClientProbeError {
+    Wire(SmartRelayWireError),
+    InvalidConfiguration,
+    RuntimeUnavailable,
+    CoordinatorBusy,
+    ContextMismatch,
+    NetworkChanged,
+    NetworkUnavailable,
+    DeadlineExceeded,
+    SelectionExpired,
+    InvalidSystemClock,
+}
+
+impl fmt::Display for ClientProbeError {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Wire(error) => write!(formatter, "smart relay wire validation failed: {error}"),
+            Self::InvalidConfiguration => formatter.write_str("invalid smart relay probe settings"),
+            Self::RuntimeUnavailable => {
+                formatter.write_str("smart relay probe runtime unavailable")
+            }
+            Self::CoordinatorBusy => formatter.write_str("smart relay probe coordinator busy"),
+            Self::ContextMismatch => formatter.write_str("smart relay probe context mismatch"),
+            Self::NetworkChanged => formatter.write_str("network changed during smart relay probe"),
+            Self::NetworkUnavailable => {
+                formatter.write_str("current network observation is unavailable")
+            }
+            Self::DeadlineExceeded => formatter.write_str("smart relay probe deadline exceeded"),
+            Self::SelectionExpired => formatter.write_str("smart relay selection expired"),
+            Self::InvalidSystemClock => formatter.write_str("system clock is invalid"),
+        }
+    }
+}
+
+impl Error for ClientProbeError {}
+
+impl From<SmartRelayWireError> for ClientProbeError {
+    fn from(error: SmartRelayWireError) -> Self {
+        Self::Wire(error)
+    }
+}
+
+trait ProbeClock: Send + Sync {
+    fn monotonic_ms(&self) -> u64;
+    fn wall_time_ms(&self) -> Result<u64, ClientProbeError>;
+}
+
+fn ensure_probe_deadline(
+    clock: &dyn ProbeClock,
+    started: Instant,
+    deadline: Duration,
+    issued_at_ms: u64,
+    signed_cutoff_ms: u64,
+) -> Result<(), ClientProbeError> {
+    let wall_ms = clock.wall_time_ms()?;
+    if started.elapsed() >= deadline || wall_ms < issued_at_ms || wall_ms >= signed_cutoff_ms {
+        return Err(ClientProbeError::DeadlineExceeded);
+    }
+    Ok(())
+}
+
+fn ensure_probe_wall_window(
+    clock: &dyn ProbeClock,
+    issued_at_ms: u64,
+    signed_cutoff_ms: u64,
+) -> Result<(), ClientProbeError> {
+    let wall_ms = clock.wall_time_ms()?;
+    if wall_ms < issued_at_ms || wall_ms >= signed_cutoff_ms {
+        return Err(ClientProbeError::DeadlineExceeded);
+    }
+    Ok(())
+}
+
+fn effective_probe_cutoff_ms(request: &SmartRelayProbeRequest) -> Result<u64, ClientProbeError> {
+    let signed_cutoff_ms = request
+        .issued_at_ms
+        .checked_add(u64::from(request.deadline_ms))
+        .ok_or(ClientProbeError::InvalidSystemClock)?;
+    let foreground_cutoff_ms = request
+        .issued_at_ms
+        .checked_add(FOREGROUND_DEADLINE_MS)
+        .ok_or(ClientProbeError::InvalidSystemClock)?;
+    Ok(signed_cutoff_ms.min(foreground_cutoff_ms))
+}
+
+struct SystemProbeClock {
+    origin: Instant,
+}
+
+impl SystemProbeClock {
+    fn new() -> Self {
+        Self {
+            origin: Instant::now(),
+        }
+    }
+}
+
+impl ProbeClock for SystemProbeClock {
+    fn monotonic_ms(&self) -> u64 {
+        u64::try_from(self.origin.elapsed().as_millis()).unwrap_or(u64::MAX)
+    }
+
+    fn wall_time_ms(&self) -> Result<u64, ClientProbeError> {
+        let elapsed = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .map_err(|_| ClientProbeError::InvalidSystemClock)?;
+        u64::try_from(elapsed.as_millis()).map_err(|_| ClientProbeError::InvalidSystemClock)
+    }
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Hash)]
+struct ProbeId([u8; 16]);
+
+#[derive(Clone, Copy, PartialEq, Eq, Hash)]
+struct CacheKey {
+    node_id: [u8; 16],
+    candidate_set_hash: [u8; 32],
+}
+
+#[derive(Clone)]
+struct CachedSuccess {
+    samples_us: Vec<u32>,
+    measured_at_ms: u64,
+}
+
+struct InflightReport {
+    request_digest: [u8; 32],
+    network: NetworkContext,
+    completion: watch::Sender<u64>,
+}
+
+struct CompletedReport {
+    request_digest: [u8; 32],
+    report: SmartRelayProbeReport,
+    expires_at_ms: u64,
+}
+
+struct RuntimeState {
+    network_signature: Option<NetworkSignatureDigest>,
+    network_epoch: [u8; 16],
+    network_generation: u64,
+    cache: HashMap<CacheKey, CachedSuccess>,
+    inflight: HashMap<ProbeId, InflightReport>,
+    completed: HashMap<ProbeId, CompletedReport>,
+}
+
+impl RuntimeState {
+    fn new() -> Self {
+        Self {
+            network_signature: None,
+            network_epoch: random_network_epoch(),
+            network_generation: 0,
+            cache: HashMap::new(),
+            inflight: HashMap::new(),
+            completed: HashMap::new(),
+        }
+    }
+
+    fn observe_network(
+        &mut self,
+        signature: NetworkSignatureDigest,
+    ) -> Result<NetworkContext, ClientProbeError> {
+        if self.network_signature == Some(signature) {
+            return Ok(self.network_context());
+        }
+        self.network_generation = self
+            .network_generation
+            .checked_add(1)
+            .ok_or(ClientProbeError::RuntimeUnavailable)?;
+        self.network_signature = Some(signature);
+        self.network_epoch = random_network_epoch();
+        self.cache.clear();
+        self.completed.clear();
+        for inflight in self.inflight.drain().map(|(_, inflight)| inflight) {
+            let _ = inflight.completion.send(2);
+        }
+        Ok(self.network_context())
+    }
+
+    fn invalidate_network(&mut self) -> Result<(), ClientProbeError> {
+        self.network_generation = self
+            .network_generation
+            .checked_add(1)
+            .ok_or(ClientProbeError::RuntimeUnavailable)?;
+        self.network_signature = None;
+        self.network_epoch = random_network_epoch();
+        self.cache.clear();
+        self.completed.clear();
+        for inflight in self.inflight.drain().map(|(_, inflight)| inflight) {
+            let _ = inflight.completion.send(2);
+        }
+        Ok(())
+    }
+
+    fn network_context(&self) -> NetworkContext {
+        NetworkContext {
+            generation: self.network_generation,
+            epoch: self.network_epoch,
+        }
+    }
+
+    fn prune(&mut self, now_ms: u64) {
+        self.cache
+            .retain(|_, entry| now_ms.saturating_sub(entry.measured_at_ms) <= STALE_CACHE_MS);
+        self.completed
+            .retain(|_, entry| now_ms < entry.expires_at_ms);
+    }
+}
+
+#[derive(Clone, Copy)]
+enum AttemptFailure {
+    Timeout,
+    Refused,
+    Network,
+    InvalidAddress,
+}
+
+trait ProbeConnector: Send + Sync {
+    fn connect<'a>(
+        &'a self,
+        endpoint: SocketAddrV4,
+        connect_timeout: Duration,
+    ) -> BoxFuture<'a, Result<Duration, AttemptFailure>>;
+}
+
+struct TcpProbeConnector;
+
+impl ProbeConnector for TcpProbeConnector {
+    fn connect<'a>(
+        &'a self,
+        endpoint: SocketAddrV4,
+        connect_timeout: Duration,
+    ) -> BoxFuture<'a, Result<Duration, AttemptFailure>> {
+        async move {
+            let started = Instant::now();
+            match timeout(
+                connect_timeout,
+                TcpStream::connect(SocketAddr::V4(endpoint)),
+            )
+            .await
+            {
+                Err(_) => Err(AttemptFailure::Timeout),
+                Ok(Ok(stream)) => {
+                    let elapsed = started.elapsed();
+                    drop(stream);
+                    Ok(elapsed)
+                }
+                Ok(Err(error)) if error.kind() == std::io::ErrorKind::ConnectionRefused => {
+                    Err(AttemptFailure::Refused)
+                }
+                Ok(Err(error))
+                    if matches!(
+                        error.kind(),
+                        std::io::ErrorKind::AddrNotAvailable | std::io::ErrorKind::InvalidInput
+                    ) =>
+                {
+                    Err(AttemptFailure::InvalidAddress)
+                }
+                Ok(Err(_)) => Err(AttemptFailure::Network),
+            }
+        }
+        .boxed()
+    }
+}
+
+struct SmartRelayClientRuntime {
+    state: Arc<Mutex<RuntimeState>>,
+    network_observer: Mutex<()>,
+    connector: Arc<dyn ProbeConnector>,
+    connect_gate: Arc<Semaphore>,
+    clock: Arc<dyn ProbeClock>,
+    config: ClientProbeConfig,
+}
+
+struct PendingProbeReportDelivery {
+    report: SmartRelayProbeReport,
+    issued_at_ms: u64,
+    effective_cutoff_ms: u64,
+}
+
+fn smart_relay_probe_runtime() -> Result<&'static SmartRelayClientRuntime, ClientProbeError> {
+    static RUNTIME: OnceLock<Result<SmartRelayClientRuntime, ClientProbeError>> = OnceLock::new();
+    RUNTIME
+        .get_or_init(SmartRelayClientRuntime::new)
+        .as_ref()
+        .map_err(Clone::clone)
+}
+
+fn invalidate_runtime_network(runtime: &SmartRelayClientRuntime) -> Result<(), ClientProbeError> {
+    runtime.invalidate_network()
+}
+
+/// Rotate the process-local network epoch after a platform lifecycle or
+/// network-change notification. The next probe captures a fresh signature;
+/// cached results and old in-flight work cannot cross the notification.
+pub(crate) fn invalidate_configured_smart_relay_network() -> Result<(), ClientProbeError> {
+    invalidate_runtime_network(smart_relay_probe_runtime()?)
+}
+
+impl SmartRelayClientRuntime {
+    fn new() -> Result<Self, ClientProbeError> {
+        hbb_common::sodiumoxide::init().map_err(|_| ClientProbeError::RuntimeUnavailable)?;
+        Ok(Self::with_dependencies(
+            ClientProbeConfig::default(),
+            Arc::new(TcpProbeConnector),
+            Arc::new(SystemProbeClock::new()),
+        ))
+    }
+
+    fn with_dependencies(
+        config: ClientProbeConfig,
+        connector: Arc<dyn ProbeConnector>,
+        clock: Arc<dyn ProbeClock>,
+    ) -> Self {
+        Self {
+            state: Arc::new(Mutex::new(RuntimeState::new())),
+            network_observer: Mutex::new(()),
+            connector,
+            connect_gate: global_connect_gate(),
+            clock,
+            config,
+        }
+    }
+
+    /// Capture and apply are serialized as one operation so an older delayed
+    /// observation can never overwrite a newer network epoch.
+    fn observe_network_with(
+        &self,
+        observe: impl FnOnce() -> Result<NetworkSignatureDigest, ClientProbeError>,
+    ) -> Result<NetworkContext, ClientProbeError> {
+        let _observer = self
+            .network_observer
+            .lock()
+            .map_err(|_| ClientProbeError::RuntimeUnavailable)?;
+        match observe() {
+            Ok(signature) => self.lock_state()?.observe_network(signature),
+            Err(error) => {
+                let _ = self.lock_state()?.invalidate_network();
+                Err(error)
+            }
+        }
+    }
+
+    #[cfg(test)]
+    fn observe_network(
+        &self,
+        signature: NetworkSignatureDigest,
+    ) -> Result<NetworkContext, ClientProbeError> {
+        self.observe_network_with(|| Ok(signature))
+    }
+
+    fn invalidate_network(&self) -> Result<(), ClientProbeError> {
+        self.lock_state()?.invalidate_network()
+    }
+
+    async fn handle_signed_probe_on_current_network(
+        &self,
+        request: SmartRelayProbeRequest,
+        hbbs_public_key: &sign::PublicKey,
+        client_id: &str,
+        device_public_key: &sign::PublicKey,
+        device_secret_key: &sign::SecretKey,
+    ) -> Result<PendingProbeReportDelivery, ClientProbeError> {
+        let issued_at_ms = request.issued_at_ms;
+        let effective_cutoff_ms = effective_probe_cutoff_ms(&request)?;
+        let report = self
+            .handle_signed_probe_with_network_observer(
+                request,
+                hbbs_public_key,
+                client_id,
+                device_public_key,
+                device_secret_key,
+                current_network_signature,
+            )
+            .await?;
+        Ok(PendingProbeReportDelivery {
+            report,
+            issued_at_ms,
+            effective_cutoff_ms,
+        })
+    }
+
+    fn finalize_probe_report_delivery(
+        &self,
+        pending: PendingProbeReportDelivery,
+    ) -> Result<SmartRelayProbeReport, ClientProbeError> {
+        let network = self.observe_network_with(current_network_signature)?;
+        if pending.report.network_epoch.as_ref() != network.epoch.as_slice() {
+            return Err(ClientProbeError::NetworkChanged);
+        }
+        ensure_probe_wall_window(
+            self.clock.as_ref(),
+            pending.issued_at_ms,
+            pending.effective_cutoff_ms,
+        )?;
+        Ok(pending.report)
+    }
+
+    async fn handle_signed_probe_with_network_observer(
+        &self,
+        request: SmartRelayProbeRequest,
+        hbbs_public_key: &sign::PublicKey,
+        client_id: &str,
+        device_public_key: &sign::PublicKey,
+        device_secret_key: &sign::SecretKey,
+        mut observe_network: impl FnMut() -> Result<NetworkSignatureDigest, ClientProbeError>,
+    ) -> Result<SmartRelayProbeReport, ClientProbeError> {
+        validate_signed_probe_request(&request, hbbs_public_key, client_id)?;
+        if device_secret_key.public_key() != *device_public_key {
+            return Err(ClientProbeError::ContextMismatch);
+        }
+        let issued_at_ms = request.issued_at_ms;
+        let effective_cutoff_ms = effective_probe_cutoff_ms(&request)?;
+        let network = self.observe_network_with(&mut observe_network)?;
+        let report = self
+            .handle_signed_probe(
+                request,
+                hbbs_public_key,
+                client_id,
+                device_secret_key,
+                network,
+            )
+            .await?;
+        let final_network = self.observe_network_with(&mut observe_network)?;
+        if final_network != network {
+            return Err(ClientProbeError::NetworkChanged);
+        }
+        verify_probe_report_signature(&report, device_public_key)?;
+        ensure_probe_wall_window(self.clock.as_ref(), issued_at_ms, effective_cutoff_ms)?;
+        Ok(report)
+    }
+
+    async fn handle_signed_probe(
+        &self,
+        request: SmartRelayProbeRequest,
+        hbbs_public_key: &sign::PublicKey,
+        client_id: &str,
+        device_secret_key: &sign::SecretKey,
+        network: NetworkContext,
+    ) -> Result<SmartRelayProbeReport, ClientProbeError> {
+        validate_signed_probe_request(&request, hbbs_public_key, client_id)?;
+        let started = Instant::now();
+        let received_wall_ms = self.clock.wall_time_ms()?;
+        let effective_cutoff_ms = effective_probe_cutoff_ms(&request)?;
+        if received_wall_ms < request.issued_at_ms || received_wall_ms >= effective_cutoff_ms {
+            return Err(ClientProbeError::DeadlineExceeded);
+        }
+        let deadline = Duration::from_millis(
+            effective_cutoff_ms
+                .saturating_sub(received_wall_ms)
+                .min(FOREGROUND_DEADLINE_MS),
+        );
+        let signed_cutoff_ms = effective_cutoff_ms;
+        let transcript = probe_request_transcript(&request)?;
+        let request_digest: [u8; 32] = Sha256::digest(&transcript).into();
+        let probe_id = ProbeId(
+            request
+                .probe_id
+                .as_ref()
+                .try_into()
+                .map_err(|_| ClientProbeError::ContextMismatch)?,
+        );
+        ensure_probe_deadline(
+            self.clock.as_ref(),
+            started,
+            deadline,
+            request.issued_at_ms,
+            signed_cutoff_ms,
+        )?;
+
+        loop {
+            ensure_probe_deadline(
+                self.clock.as_ref(),
+                started,
+                deadline,
+                request.issued_at_ms,
+                signed_cutoff_ms,
+            )?;
+            let now_ms = self.clock.monotonic_ms();
+            let admission = {
+                let mut state = self.lock_state()?;
+                ensure_probe_deadline(
+                    self.clock.as_ref(),
+                    started,
+                    deadline,
+                    request.issued_at_ms,
+                    signed_cutoff_ms,
+                )?;
+                if state.network_context() != network || state.network_signature.is_none() {
+                    return Err(ClientProbeError::NetworkChanged);
+                }
+                state.prune(now_ms);
+                if let Some(completed) = state.completed.get(&probe_id) {
+                    if completed.request_digest != request_digest {
+                        return Err(ClientProbeError::ContextMismatch);
+                    }
+                    ProbeAdmission::Completed(completed.report.clone())
+                } else if let Some(inflight) = state.inflight.get(&probe_id) {
+                    if inflight.request_digest != request_digest {
+                        return Err(ClientProbeError::ContextMismatch);
+                    }
+                    ProbeAdmission::Join(inflight.completion.subscribe())
+                } else {
+                    if state.inflight.len() >= MAX_INFLIGHT_REPORTS
+                        || state.completed.len().saturating_add(state.inflight.len())
+                            >= MAX_COMPLETED_REPORTS
+                    {
+                        return Err(ClientProbeError::CoordinatorBusy);
+                    }
+                    let (completion, _) = watch::channel(0_u64);
+                    state.inflight.insert(
+                        probe_id,
+                        InflightReport {
+                            request_digest,
+                            network,
+                            completion: completion.clone(),
+                        },
+                    );
+                    ProbeAdmission::Own {
+                        completion,
+                        network,
+                    }
+                }
+            };
+            let (completion, network) = match admission {
+                ProbeAdmission::Completed(report) => {
+                    ensure_probe_deadline(
+                        self.clock.as_ref(),
+                        started,
+                        deadline,
+                        request.issued_at_ms,
+                        signed_cutoff_ms,
+                    )?;
+                    return Ok(report);
+                }
+                ProbeAdmission::Join(mut completion) => {
+                    let remaining = deadline
+                        .checked_sub(started.elapsed())
+                        .ok_or(ClientProbeError::DeadlineExceeded)?;
+                    timeout(remaining, completion.changed())
+                        .await
+                        .map_err(|_| ClientProbeError::DeadlineExceeded)?
+                        .map_err(|_| ClientProbeError::RuntimeUnavailable)?;
+                    ensure_probe_deadline(
+                        self.clock.as_ref(),
+                        started,
+                        deadline,
+                        request.issued_at_ms,
+                        signed_cutoff_ms,
+                    )?;
+                    continue;
+                }
+                ProbeAdmission::Own {
+                    completion,
+                    network,
+                } => (completion, network),
+            };
+
+            let mut owner = InflightOwner::new(
+                self.state.clone(),
+                probe_id,
+                request_digest,
+                network,
+                completion,
+            );
+            let cancellation = owner.completion.subscribe();
+            let report = self
+                .measure_and_sign(ProbeExecution {
+                    request: &request,
+                    client_id,
+                    device_secret_key,
+                    network,
+                    started,
+                    deadline,
+                    issued_at_ms: request.issued_at_ms,
+                    signed_cutoff_ms,
+                    cancellation,
+                })
+                .await?;
+            ensure_probe_deadline(
+                self.clock.as_ref(),
+                started,
+                deadline,
+                request.issued_at_ms,
+                signed_cutoff_ms,
+            )?;
+            owner.complete(
+                report.clone(),
+                self.clock.monotonic_ms(),
+                started,
+                deadline,
+                self.clock.as_ref(),
+                request.issued_at_ms,
+                signed_cutoff_ms,
+            )?;
+            return Ok(report);
+        }
+    }
+
+    async fn measure_and_sign(
+        &self,
+        execution: ProbeExecution<'_>,
+    ) -> Result<SmartRelayProbeReport, ClientProbeError> {
+        let ProbeExecution {
+            request,
+            client_id,
+            device_secret_key,
+            network,
+            started,
+            deadline,
+            issued_at_ms,
+            signed_cutoff_ms,
+            cancellation,
+        } = execution;
+        let candidate_hash: [u8; 32] = request
+            .candidate_set_hash
+            .as_ref()
+            .try_into()
+            .map_err(|_| ClientProbeError::ContextMismatch)?;
+        let cache_now_ms = self.clock.monotonic_ms();
+        let (mut results, plans) = {
+            let state = self.lock_state()?;
+            if state.network_context() != network || state.network_signature.is_none() {
+                return Err(ClientProbeError::NetworkChanged);
+            }
+            let mut results = Vec::with_capacity(request.candidates.len());
+            let mut plans = Vec::new();
+            for candidate in &request.candidates {
+                let mut parsed = ParsedCandidate::try_from(candidate)?;
+                parsed.candidate_set_hash = candidate_hash;
+                let key = CacheKey {
+                    node_id: parsed.node_id,
+                    candidate_set_hash: candidate_hash,
+                };
+                let cached = state.cache.get(&key).cloned();
+                if let Some(cached) = cached.as_ref().filter(|cached| {
+                    cache_now_ms.saturating_sub(cached.measured_at_ms) < FRESH_CACHE_MS
+                }) {
+                    results.push(success_result(
+                        parsed.node_id,
+                        cached.samples_us.clone(),
+                        cache_now_ms.saturating_sub(cached.measured_at_ms).max(1),
+                    ));
+                } else {
+                    plans.push(ProbePlan {
+                        candidate: parsed,
+                        stale: cached.filter(|cached| {
+                            cache_now_ms.saturating_sub(cached.measured_at_ms) <= STALE_CACHE_MS
+                        }),
+                    });
+                }
+            }
+            (results, plans)
+        };
+
+        let mut measured = self
+            .measure_candidates(
+                plans,
+                started,
+                deadline,
+                issued_at_ms,
+                signed_cutoff_ms,
+                cancellation,
+            )
+            .await?;
+        ensure_probe_deadline(
+            self.clock.as_ref(),
+            started,
+            deadline,
+            issued_at_ms,
+            signed_cutoff_ms,
+        )?;
+        results.append(&mut measured.results);
+        results.sort_by(|left, right| left.node_id.as_ref().cmp(right.node_id.as_ref()));
+
+        {
+            let mut state = self.lock_state()?;
+            ensure_probe_deadline(
+                self.clock.as_ref(),
+                started,
+                deadline,
+                issued_at_ms,
+                signed_cutoff_ms,
+            )?;
+            if state.network_context() != network || state.network_signature.is_none() {
+                return Err(ClientProbeError::NetworkChanged);
+            }
+            state.prune(measured.finished_at_ms);
+            for success in measured.cache_updates {
+                if state.cache.len() >= MAX_CACHE_ENTRIES && !state.cache.contains_key(&success.0) {
+                    continue;
+                }
+                state.cache.insert(success.0, success.1);
+            }
+        }
+
+        if started.elapsed() >= deadline {
+            return Err(ClientProbeError::DeadlineExceeded);
+        }
+        let mut report = SmartRelayProbeReport::new();
+        report.protocol_version = SMART_RELAY_PROTOCOL_V1;
+        report.probe_id = request.probe_id.clone();
+        report.role_nonce = request.role_nonce.clone();
+        report.candidate_set_hash = request.candidate_set_hash.clone();
+        report.role = request.role;
+        report.client_id = client_id.to_owned();
+        report.network_epoch = Bytes::copy_from_slice(&network.epoch);
+        report.results = results;
+        report.sent_at_ms = self.clock.wall_time_ms()?.max(1);
+        let report_transcript = probe_report_transcript(&report)?;
+        report.client_signature =
+            Bytes::copy_from_slice(&sign_transcript(&report_transcript, device_secret_key));
+        validate_probe_report_for_request(&report, request)?;
+        Ok(report)
+    }
+
+    async fn measure_candidates(
+        &self,
+        plans: Vec<ProbePlan>,
+        started: Instant,
+        deadline: Duration,
+        issued_at_ms: u64,
+        signed_cutoff_ms: u64,
+        mut cancellation: watch::Receiver<u64>,
+    ) -> Result<MeasuredCandidates, ClientProbeError> {
+        let mut accumulators: HashMap<[u8; 16], AttemptAccumulator> = plans
+            .iter()
+            .map(|plan| (plan.candidate.node_id, AttemptAccumulator::default()))
+            .collect();
+        let mut pending = FuturesUnordered::new();
+        for plan in &plans {
+            for _ in 0..self.config.attempts_per_candidate {
+                let connector = self.connector.clone();
+                let gate = self.connect_gate.clone();
+                let clock = self.clock.clone();
+                let candidate = plan.candidate;
+                let connect_timeout_ms = candidate
+                    .probe_timeout_ms
+                    .min(self.config.connect_timeout_ms);
+                pending.push(
+                    async move {
+                        let permit = gate
+                            .acquire_owned()
+                            .await
+                            .map_err(|_| ClientProbeError::RuntimeUnavailable)?;
+                        ensure_probe_deadline(
+                            clock.as_ref(),
+                            started,
+                            deadline,
+                            issued_at_ms,
+                            signed_cutoff_ms,
+                        )?;
+                        let outcome = connector
+                            .connect(
+                                candidate.endpoint,
+                                Duration::from_millis(u64::from(connect_timeout_ms)),
+                            )
+                            .await;
+                        drop(permit);
+                        Ok::<_, ClientProbeError>((candidate.node_id, outcome))
+                    }
+                    .boxed(),
+                );
+            }
+        }
+
+        let remaining = deadline
+            .checked_sub(started.elapsed())
+            .ok_or(ClientProbeError::DeadlineExceeded)?;
+        let completed_all = hbb_common::tokio::select! {
+            changed = cancellation.changed() => {
+                changed.map_err(|_| ClientProbeError::RuntimeUnavailable)?;
+                return Err(ClientProbeError::NetworkChanged);
+            }
+            completed = timeout(remaining, async {
+                while let Some(outcome) = pending.next().await {
+                    let (node_id, outcome) = outcome?;
+                    if let Some(accumulator) = accumulators.get_mut(&node_id) {
+                        accumulator.record(outcome);
+                    }
+                }
+                Ok::<(), ClientProbeError>(())
+            }) => completed,
+        };
+        match completed_all {
+            Ok(result) => result?,
+            Err(_) => {
+                drop(pending);
+            }
+        }
+
+        let finished_at_ms = self.clock.monotonic_ms();
+        let mut results = Vec::with_capacity(plans.len());
+        let mut cache_updates = Vec::new();
+        for plan in plans {
+            let accumulator = accumulators
+                .remove(&plan.candidate.node_id)
+                .unwrap_or_default();
+            if !accumulator.samples_us.is_empty() {
+                let samples = accumulator.sorted_samples();
+                results.push(success_result(plan.candidate.node_id, samples.clone(), 0));
+                cache_updates.push((
+                    CacheKey {
+                        node_id: plan.candidate.node_id,
+                        candidate_set_hash: plan.candidate.candidate_set_hash,
+                    },
+                    CachedSuccess {
+                        samples_us: samples,
+                        measured_at_ms: finished_at_ms,
+                    },
+                ));
+            } else if let Some(stale) = plan.stale {
+                results.push(success_result(
+                    plan.candidate.node_id,
+                    stale.samples_us,
+                    finished_at_ms.saturating_sub(stale.measured_at_ms),
+                ));
+            } else {
+                results.push(failure_result(
+                    plan.candidate.node_id,
+                    accumulator.failure_status(),
+                ));
+            }
+        }
+        Ok(MeasuredCandidates {
+            results,
+            cache_updates,
+            finished_at_ms,
+        })
+    }
+
+    fn lock_state(&self) -> Result<MutexGuard<'_, RuntimeState>, ClientProbeError> {
+        self.state
+            .lock()
+            .map_err(|_| ClientProbeError::RuntimeUnavailable)
+    }
+}
