+#[derive(Clone, Copy)]
+pub(crate) struct ClientProbeConfig {
+    attempts_per_candidate: usize,
+    connect_timeout_ms: u32,
+}
+
+impl Default for ClientProbeConfig {
+    fn default() -> Self {
+        Self {
+            attempts_per_candidate: DEFAULT_ATTEMPTS_PER_CANDIDATE,
+            connect_timeout_ms: DEFAULT_CONNECT_TIMEOUT_MS,
+        }
+    }
+}
+
+impl ClientProbeConfig {
+    pub(crate) fn new(
+        attempts_per_candidate: usize,
+        connect_timeout_ms: u32,
+    ) -> Result<Self, ClientProbeError> {
+        if !(1..=3).contains(&attempts_per_candidate) {
+            return Err(ClientProbeError::InvalidConfiguration);
+        }
+        if !(SMART_RELAY_MIN_CONNECT_TIMEOUT_MS..=SMART_RELAY_MAX_CONNECT_TIMEOUT_MS)
+            .contains(&connect_timeout_ms)
+        {
+            return Err(ClientProbeError::InvalidConfiguration);
+        }
+        Ok(Self {
+            attempts_per_candidate,
+            connect_timeout_ms,
+        })
+    }
+}
