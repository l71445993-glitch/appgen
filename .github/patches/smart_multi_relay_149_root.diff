+fn verified_punch_selection(
+    punch_offer: Option<&SmartRelayConnectOffer>,
+    selection: MessageField<SmartRelaySelection>,
+    target_id: &str,
+    conn_type: ConnType,
+    force_relay: bool,
+    relay_server: &str,
+) -> ResultType<Option<VerifiedSmartRelaySelection>> {
+    let Some(selection) = selection.into_option() else {
+        return Ok(None);
+    };
+    let punch_offer = punch_offer.ok_or_else(|| anyhow!("unexpected smart relay selection"))?;
+    let mut hbbs_key = Config::get_option("key");
+    if hbbs_key.is_empty() {
+        hbbs_key = config::RS_PUB_KEY.to_owned();
+    }
+    let hbbs_public_key = get_rs_pk(&hbbs_key)
+        .ok_or_else(|| anyhow!("smart relay server identity is unavailable"))?;
+    let (_, device_public_key) = Config::get_key_pair();
+    verify_punch_selection(
+        hbbs_public_key.as_ref(),
+        &device_public_key,
+        punch_offer,
+        target_id,
+        conn_type,
+        force_relay,
+        relay_server,
+        selection,
+    )
+    .map(Some)
+    .map_err(|error| anyhow!("smart relay selection rejected: {error}"))
+}
+
+fn relay_connect_offer(
+    selection: &VerifiedSmartRelaySelection,
+    target_id: &str,
+    conn_type: ConnType,
+    secure: bool,
+    relay_attempt_uuid: &str,
+    relay_server: &str,
+) -> ResultType<SmartRelayConnectOffer> {
+    let (device_secret_key, device_public_key) = Config::get_key_pair();
+    signed_relay_connect_offer(
+        selection,
+        target_id,
+        conn_type,
+        secure,
+        relay_attempt_uuid,
+        relay_server,
+        &device_public_key,
+        &device_secret_key,
+    )
+    .map_err(|error| anyhow!("smart relay RELAY offer rejected: {error}"))
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum RelayRefusalDisposition {
+    RetryWithNewUuid,
+    RetryWithoutSmart,
+    RestartRendezvous,
+    Fatal,
+}
+
+fn relay_refusal_disposition(reason: &str, attempted_smart: bool) -> RelayRefusalDisposition {
+    if !attempted_smart {
+        return RelayRefusalDisposition::Fatal;
+    }
+    match reason {
+        "SMART_COORDINATOR_BUSY" => RelayRefusalDisposition::RetryWithoutSmart,
+        "RELAY_ATTEMPT_REPLAY_MISS" | "RELAY_ATTEMPT_CONTEXT_MISMATCH" => {
+            RelayRefusalDisposition::RetryWithNewUuid
+        }
+        "SELECTION_REPLAY_MISS" | "CONNECT_REPLAY_CONTEXT_MISMATCH" => {
+            RelayRefusalDisposition::RestartRendezvous
+        }
+        _ => RelayRefusalDisposition::Fatal,
+    }
+}
+
+#[derive(Debug)]
+struct SmartRendezvousRestart {
+    reason: String,
+}
+
+impl std::fmt::Display for SmartRendezvousRestart {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(
+            formatter,
+            "smart relay rendezvous restart required: {}",
+            self.reason
+        )
+    }
+}
+
+impl std::error::Error for SmartRendezvousRestart {}
+
+#[cfg(test)]
+mod smart_relay_refusal_tests {
+    use super::*;
+
+    #[test]
+    fn classifies_only_known_smart_refusals_for_bounded_recovery() {
+        assert_eq!(
+            relay_refusal_disposition("SMART_COORDINATOR_BUSY", true),
+            RelayRefusalDisposition::RetryWithoutSmart
+        );
+        for reason in [
+            "RELAY_ATTEMPT_REPLAY_MISS",
+            "RELAY_ATTEMPT_CONTEXT_MISMATCH",
+        ] {
+            assert_eq!(
+                relay_refusal_disposition(reason, true),
+                RelayRefusalDisposition::RetryWithNewUuid
+            );
+        }
+        for reason in ["SELECTION_REPLAY_MISS", "CONNECT_REPLAY_CONTEXT_MISMATCH"] {
+            assert_eq!(
+                relay_refusal_disposition(reason, true),
+                RelayRefusalDisposition::RestartRendezvous
+            );
+        }
+        assert_eq!(
+            relay_refusal_disposition("UNKNOWN_REFUSAL", true),
+            RelayRefusalDisposition::Fatal
+        );
+    }
+
+    #[test]
+    fn compatibility_requests_fail_closed_on_smart_refusals() {
+        for reason in [
+            "SMART_COORDINATOR_BUSY",
+            "RELAY_ATTEMPT_REPLAY_MISS",
+            "RELAY_ATTEMPT_CONTEXT_MISMATCH",
+            "SELECTION_REPLAY_MISS",
+            "CONNECT_REPLAY_CONTEXT_MISMATCH",
+        ] {
+            assert_eq!(
+                relay_refusal_disposition(reason, false),
+                RelayRefusalDisposition::Fatal
+            );
+        }
+    }
+}
