+    #[test]
+    fn bounded_attempt_registry_is_raii_fail_closed_and_tombstones_success() {
+        let now = Instant::now();
+        let registry = Arc::new(StdMutex::new(BoundedAttemptRegistry::new(
+            2,
+            Duration::from_secs(60),
+        )));
+        let digest_a = [0xA1; 32];
+        let digest_b = [0xB2; 32];
+        let owner = match reserve_attempt(&registry, 1_u8, digest_a, now).unwrap() {
+            AttemptReservation::Owner(lease) => lease,
+            AttemptReservation::Duplicate => panic!("first reservation must be owner"),
+        };
+        assert!(matches!(
+            reserve_attempt(&registry, 1_u8, digest_a, now),
+            Ok(AttemptReservation::Duplicate)
+        ));
+        assert_eq!(
+            reserve_attempt(&registry, 1_u8, digest_b, now).err(),
+            Some(AttemptReservationError::ContextMismatch)
+        );
+        let mut second = match reserve_attempt(&registry, 2_u8, digest_b, now).unwrap() {
+            AttemptReservation::Owner(lease) => lease,
+            AttemptReservation::Duplicate => panic!("different key must be owner"),
+        };
+        assert_eq!(
+            reserve_attempt(&registry, 3_u8, [0xC3; 32], now).err(),
+            Some(AttemptReservationError::CapacityExhausted)
+        );
+        drop(owner);
+        let _replacement = match reserve_attempt(&registry, 3_u8, [0xC3; 32], now).unwrap() {
+            AttemptReservation::Owner(lease) => lease,
+            AttemptReservation::Duplicate => panic!("dropped owner must release its reservation"),
+        };
+        second.complete(now).unwrap();
+        assert!(matches!(
+            reserve_attempt(&registry, 2_u8, digest_b, now + Duration::from_secs(59),),
+            Ok(AttemptReservation::Duplicate)
+        ));
+    }
