+fn reserve_attempt<K: Eq + std::hash::Hash + Clone>(
+    registry: &Arc<StdMutex<BoundedAttemptRegistry<K>>>,
+    key: K,
+    context_digest: [u8; 32],
+    now: Instant,
+) -> Result<AttemptReservation<K>, AttemptReservationError> {
+    let mut state = registry
+        .lock()
+        .map_err(|_| AttemptReservationError::Unavailable)?;
+    state.entries.retain(|_, entry| {
+        entry
+            .completed_until
+            .map(|expires_at| now < expires_at)
+            .unwrap_or(true)
+    });
+    if let Some(entry) = state.entries.get(&key) {
+        return if entry.context_digest == context_digest {
+            Ok(AttemptReservation::Duplicate)
+        } else {
+            Err(AttemptReservationError::ContextMismatch)
+        };
+    }
+    if state.entries.len() >= state.capacity {
+        return Err(AttemptReservationError::CapacityExhausted);
+    }
+    state.entries.insert(
+        key.clone(),
+        AttemptEntry {
+            context_digest,
+            completed_until: None,
+        },
+    );
+    drop(state);
+    Ok(AttemptReservation::Owner(AttemptLease {
+        registry: registry.clone(),
+        key,
+        context_digest,
+        active: true,
+    }))
+}
+
+fn reserve_target_relay_attempt(
