+
+pub(crate) fn signed_registration_capability(
+    hbbs_public_key: &[u8],
+    peer_id: &str,
+    device_public_key: &[u8],
+    device_secret_key: &[u8],
+    register_pk: bool,
+) -> Result<SmartRelayCapability, ClientProbeError> {
+    let device_public_key = sign::PublicKey::from_slice(device_public_key)
+        .ok_or(SmartRelayWireError::InvalidLength("device public key"))?;
+    let device_secret_key = sign::SecretKey::from_slice(device_secret_key)
+        .ok_or(SmartRelayWireError::InvalidLength("device secret key"))?;
+    let capability = if register_pk {
+        signed_register_pk_capability(
+            hbbs_public_key,
+            peer_id,
+            device_public_key.as_ref(),
+            &device_secret_key,
+        )?
+    } else {
+        signed_register_peer_capability(hbbs_public_key, peer_id, &device_secret_key)?
+    };
+    verify_capability_signature(
+        CapabilityTranscriptContext {
+            hbbs_key_fingerprint: &hbbs_key_fingerprint(hbbs_public_key)?,
+            outer_peer_id: peer_id,
+            register_pk_public_key: register_pk.then_some(device_public_key.as_ref()),
+        },
+        &capability,
+        &device_public_key,
+    )?;
+    Ok(capability)
+}
