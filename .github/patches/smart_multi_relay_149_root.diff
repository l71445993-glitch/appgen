+    #[test]
+    fn smart_initial_dedupe_is_selection_scoped_bounded_and_validation_gated() {
+        let (first_hbbs_key, first_selection) =
+            signed_initial_selection_with_nonce("target-b", "1.1.1.1:21117", 0x31);
+        let (second_hbbs_key, second_selection) =
+            signed_initial_selection_with_nonce("target-b", "1.1.1.1:21117", 0x32);
+        let first = verify_target_initial_selection(
+            first_hbbs_key.as_ref(),
+            "target-b",
+            "1.1.1.1:21117",
+            TargetInitialEnvelope::PunchHole,
+            Some(&first_selection),
+        )
+        .unwrap()
+        .unwrap();
+        let second = verify_target_initial_selection(
+            second_hbbs_key.as_ref(),
+            "target-b",
+            "1.1.1.1:21117",
+            TargetInitialEnvelope::PunchHole,
+            Some(&second_selection),
+        )
+        .unwrap()
+        .unwrap();
+        let intranet = verify_target_initial_selection(
+            first_hbbs_key.as_ref(),
+            "target-b",
+            "1.1.1.1:21117",
+            TargetInitialEnvelope::FetchLocalAddr,
+            Some(&first_selection),
+        )
+        .unwrap()
+        .unwrap();
+        let (first_key, first_digest) = first.dedupe_context();
+        let (second_key, second_digest) = second.dedupe_context();
+        let (intranet_key, intranet_digest) = intranet.dedupe_context();
+        assert_ne!(first_key, second_key);
+        assert_ne!(first_key, intranet_key);
