+    #[test]
+    fn interleaved_messages_share_one_absolute_receive_deadline() {
+        let started = Instant::now();
+        let deadline = started + Duration::from_millis(3_000);
+        let after_probe = started + Duration::from_millis(1_500);
+        let just_before_deadline = deadline - Duration::from_millis(1);
+
+        assert_eq!(remaining_receive_ms(deadline, started), Some(3_000));
+        assert_eq!(remaining_receive_ms(deadline, after_probe), Some(1_500));
+        assert_eq!(
+            remaining_receive_ms(deadline, just_before_deadline),
+            Some(1)
+        );
+        assert_eq!(remaining_receive_ms(deadline, deadline), None);
+        assert_eq!(
+            remaining_receive_ms(deadline, deadline + Duration::from_millis(1)),
+            None
+        );
+    }
