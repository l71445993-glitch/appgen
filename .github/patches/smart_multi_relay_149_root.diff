+fn punch_connect_offer(
+    target_id: &str,
+    conn_type: ConnType,
+    force_relay: bool,
+) -> Option<SmartRelayConnectOffer> {
+    let mut hbbs_key = Config::get_option("key");
+    if hbbs_key.is_empty() {
+        hbbs_key = config::RS_PUB_KEY.to_owned();
+    }
+    let hbbs_public_key = get_rs_pk(&hbbs_key)?;
+    let requester_id = Config::get_id();
+    let (device_secret_key, device_public_key) = Config::get_key_pair();
+    match signed_punch_connect_offer(
+        hbbs_public_key.as_ref(),
+        &requester_id,
+        target_id,
+        conn_type,
+        force_relay,
+        &device_public_key,
+        &device_secret_key,
+    ) {
+        Ok(offer) => Some(offer),
+        Err(error) => {
+            log::warn!("smart relay PUNCH offer omitted: {error}");
+            None
+        }
+    }
+}
+
+fn remaining_receive_ms(deadline: Instant, now: Instant) -> Option<u64> {
+    let remaining = deadline.checked_duration_since(now)?;
+    if remaining.is_zero() {
+        return None;
+    }
+    Some(
+        u64::try_from(remaining.as_millis())
+            .unwrap_or(u64::MAX)
+            .max(1),
+    )
+}
+
+async fn next_rendezvous_message_until(
+    socket: &mut Stream,
+    deadline: Instant,
+) -> Option<RendezvousMessage> {
+    loop {
+        let remaining_ms = remaining_receive_ms(deadline, Instant::now())?;
+        let bytes = socket.next_timeout(remaining_ms).await?.ok()?;
+        let message = RendezvousMessage::parse_from_bytes(&bytes).ok()?;
+        if matches!(
+            message.union,
+            Some(rendezvous_message::Union::KeyExchange(_))
+        ) {
+            continue;
+        }
+        return Some(message);
+    }
+}
+
+#[cfg(test)]
+async fn next_non_probe_rendezvous_message_until<F, Fut>(
+    socket: &mut Stream,
+    receive_deadline: Instant,
+    accept_probe: bool,
+    mut handle_probe: F,
+) -> ResultType<Option<RendezvousMessage>>
+where
+    F: FnMut(SmartRelayProbeRequest) -> Fut,
+    Fut: std::future::Future<Output = ResultType<SmartRelayProbeReport>>,
+{
+    loop {
+        let Some(mut message) = next_rendezvous_message_until(socket, receive_deadline).await
+        else {
+            return Ok(None);
+        };
+        match message.union.take() {
+            Some(rendezvous_message::Union::SmartRelayProbeRequest(request)) if accept_probe => {
+                let remaining_ms = remaining_receive_ms(receive_deadline, Instant::now())
+                    .ok_or_else(|| anyhow!("smart relay rendezvous receive deadline exceeded"))?;
+                let report = match timeout(remaining_ms, handle_probe(request)).await {
+                    Ok(Ok(report)) => report,
+                    Ok(Err(error)) => {
+                        log::debug!(
+                            "smart relay probe request rejected on rendezvous stream: {error}"
+                        );
+                        continue;
+                    }
+                    Err(_) => bail!("smart relay rendezvous receive deadline exceeded"),
+                };
+                let mut response = RendezvousMessage::new();
+                response.set_smart_relay_probe_report(report);
+                let remaining_ms = remaining_receive_ms(receive_deadline, Instant::now())
+                    .ok_or_else(|| anyhow!("smart relay rendezvous receive deadline exceeded"))?;
+                timeout(remaining_ms, socket.send(&response)).await??;
+            }
+            union => {
+                message.union = union;
+                return Ok(Some(message));
+            }
+        }
+    }
+}
+
+async fn next_configured_rendezvous_message_until(
+    connection: &mut FrozenRendezvousConnection,
+    receive_deadline: Instant,
+) -> ResultType<Option<RendezvousMessage>> {
+    loop {
+        let Some(mut message) =
+            next_rendezvous_message_until(&mut connection.stream, receive_deadline).await
+        else {
+            return Ok(None);
+        };
+        match message.union.take() {
+            Some(rendezvous_message::Union::SmartRelayProbeRequest(request))
+                if connection.allows_smart_probe() =>
+            {
+                log::debug!(
+                    "handling smart relay probe on trusted rendezvous connection {}",
+                    connection.transport_endpoint
+                );
+                let remaining_ms = remaining_receive_ms(receive_deadline, Instant::now())
+                    .ok_or_else(|| anyhow!("smart relay rendezvous receive deadline exceeded"))?;
+                let report = match timeout(
+                    remaining_ms,
+                    handle_configured_smart_relay_probe_request_from_trusted_stream(
+                        request,
+                        connection
+                            .probe_trust
+                            .ok_or_else(|| anyhow!("rendezvous probe stream is untrusted"))?,
+                    ),
+                )
+                .await
+                {
+                    Ok(Ok(report)) => report,
+                    Ok(Err(error)) => {
+                        log::debug!(
+                            "smart relay probe request rejected on rendezvous stream: {error}"
+                        );
+                        continue;
+                    }
+                    Err(_) => bail!("smart relay rendezvous receive deadline exceeded"),
+                };
+                let mut response = RendezvousMessage::new();
+                response.set_smart_relay_probe_report(report);
+                let remaining_ms = remaining_receive_ms(receive_deadline, Instant::now())
+                    .ok_or_else(|| anyhow!("smart relay rendezvous receive deadline exceeded"))?;
+                timeout(remaining_ms, connection.stream.send(&response)).await??;
+            }
+            union => {
+                message.union = union;
+                return Ok(Some(message));
+            }
+        }
+    }
+}
+
+#[derive(Clone, Copy)]
+pub(crate) struct RendezvousProbeTrust(RendezvousProbeTrustKind);
+
+#[derive(Clone, Copy)]
+enum RendezvousProbeTrustKind {
+    ApplicationSecured,
+    StrictWebSocketTls,
+}
+
+struct FrozenRendezvousConnection {
+    stream: Stream,
+    transport_endpoint: String,
+    probe_trust: Option<RendezvousProbeTrust>,
+}
+
+impl FrozenRendezvousConnection {
+    fn from_connected_stream(
+        stream: Stream,
+        transport_endpoint: String,
+        insecure_tls_fallback: bool,
+    ) -> Self {
+        let probe_trust = strict_wss_probe_trust_for_connected_stream(
+            &stream,
+            &transport_endpoint,
+            insecure_tls_fallback,
+        );
+        Self {
+            stream,
+            transport_endpoint,
+            probe_trust,
+        }
+    }
+
+    fn refresh_application_security(&mut self) {
+        if self.stream.is_secured() {
+            self.probe_trust = Some(RendezvousProbeTrust(
+                RendezvousProbeTrustKind::ApplicationSecured,
+            ));
+        }
+    }
+
+    fn allows_smart_probe(&self) -> bool {
+        self.allows_smart_probe_with_insecure_tls_fallback(config::allow_insecure_tls_fallback())
+    }
+
+    fn allows_smart_probe_with_insecure_tls_fallback(&self, insecure_tls_fallback: bool) -> bool {
+        match self.probe_trust.map(|trust| trust.0) {
+            Some(RendezvousProbeTrustKind::ApplicationSecured) => true,
+            Some(RendezvousProbeTrustKind::StrictWebSocketTls) => !insecure_tls_fallback,
+            None => false,
+        }
+    }
+}
+
+impl std::ops::Deref for FrozenRendezvousConnection {
+    type Target = Stream;
+
+    fn deref(&self) -> &Self::Target {
+        &self.stream
+    }
+}
+
+impl std::ops::DerefMut for FrozenRendezvousConnection {
+    fn deref_mut(&mut self) -> &mut Self::Target {
+        &mut self.stream
+    }
+}
+
+fn is_verified_strict_wss_connection(
+    transport_endpoint: &str,
+    has_strict_tls_handshake: bool,
+    insecure_tls_fallback: bool,
+) -> bool {
+    url::Url::parse(transport_endpoint)
+        .ok()
+        .is_some_and(|url| url.scheme() == "wss")
+        && has_strict_tls_handshake
+        && !insecure_tls_fallback
+}
+
+fn strict_wss_probe_trust_for_connected_stream(
+    stream: &Stream,
+    transport_endpoint: &str,
+    insecure_tls_fallback: bool,
+) -> Option<RendezvousProbeTrust> {
+    is_verified_strict_wss_connection(
+        transport_endpoint,
+        stream.has_strict_websocket_tls_handshake(),
+        insecure_tls_fallback,
+    )
+    .then_some(RendezvousProbeTrust(
+        RendezvousProbeTrustKind::StrictWebSocketTls,
+    ))
+}
+
+async fn connect_frozen_rendezvous_endpoint(
+    endpoint: &str,
+) -> ResultType<FrozenRendezvousConnection> {
+    let transport_endpoint = hbb_common::websocket::check_ws(endpoint);
+    let stream = connect_tcp(transport_endpoint.clone(), CONNECT_TIMEOUT).await?;
+    Ok(FrozenRendezvousConnection::from_connected_stream(
+        stream,
+        transport_endpoint,
+        config::allow_insecure_tls_fallback(),
+    ))
+}
