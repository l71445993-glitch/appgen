+    fn signed_target_relay_request(
+        hbbs_public: &sign::PublicKey,
+        hbbs_secret: &sign::SecretKey,
+        device_secret: &sign::SecretKey,
+        issued_at_ms: u64,
+        expires_at_ms: u64,
+    ) -> RequestRelay {
+        let mut punch_offer = SmartRelayConnectOffer::new();
+        punch_offer.protocol_version = SMART_RELAY_PROTOCOL_V1;
+        punch_offer.requester_id = "requester-a".to_owned();
+        punch_offer.request_nonce = Bytes::copy_from_slice(&[0x31; 16]);
+        punch_offer.issued_at_ms = issued_at_ms.saturating_sub(1);
+        let selection = signed_selection(&punch_offer, hbbs_secret, expires_at_ms);
+
+        let mut offer = SmartRelayConnectOffer::new();
+        offer.protocol_version = SMART_RELAY_PROTOCOL_V1;
+        offer.requester_id = "requester-a".to_owned();
+        offer.request_nonce = punch_offer.request_nonce;
+        offer.issued_at_ms = issued_at_ms;
+        offer.selection = MessageField::some(selection);
+        let context = RelayConnectTranscriptContext {
+            hbbs_key_fingerprint: &hbbs_key_fingerprint(hbbs_public.as_ref()).unwrap(),
+            requester_id: "requester-a",
+            target_id: "target-b",
+            conn_type: ConnType::TERMINAL,
+            secure: true,
+            relay_attempt_uuid: "attempt-1",
+            relay_server: "1.1.1.1:21117",
+        };
+        offer.signature = Bytes::copy_from_slice(&sign_transcript(
+            &relay_connect_transcript(context, &offer).unwrap(),
+            device_secret,
+        ));
+
+        let mut request = RequestRelay::new();
+        request.id = "target-b".to_owned();
+        request.uuid = "attempt-1".to_owned();
+        request.relay_server = "1.1.1.1:21117".to_owned();
+        request.secure = true;
+        request.conn_type = ConnType::TERMINAL.into();
+        request.smart_relay = MessageField::some(offer);
+        request
+    }
