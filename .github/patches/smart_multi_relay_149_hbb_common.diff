+    #[test]
+    fn signatures_round_trip_without_signing_protobuf_serialization() {
+        sodiumoxide::init().unwrap();
+        let (public_key, secret_key) = sign::gen_keypair();
+        for (_, transcript) in golden_transcripts() {
+            let signature = sign_transcript(&transcript, &secret_key);
+            verify_transcript(&transcript, &signature, &public_key).unwrap();
+            let mut tampered = transcript;
+            let last = tampered.last_mut().unwrap();
+            *last ^= 1;
+            assert!(matches!(
+                verify_transcript(&tampered, &signature, &public_key),
+                Err(SmartRelayWireError::InvalidSignature)
+            ));
+        }
+
+        let selection = selection();
+        let canonical = selection_transcript(&selection).unwrap();
+        let protobuf = selection.write_to_bytes().unwrap();
+        let blob = signed_selection_blob(&selection).unwrap();
+        assert_ne!(canonical, protobuf);
+        assert_ne!(blob, protobuf);
+        assert_eq!(
+            u32::from_be_bytes(blob[..4].try_into().unwrap()) as usize,
+            canonical.len()
+        );
+
+        let relay = connect_offer(true);
+        let relay_transcript = relay_connect_transcript(
+            RelayConnectTranscriptContext {
+                hbbs_key_fingerprint: &[0x60; 32],
+                requester_id: "requester-a",
+                target_id: "target-b",
+                conn_type: ConnType::TERMINAL,
+                secure: true,
+                relay_attempt_uuid: "attempt-0001",
+                relay_server: "1.1.1.1:21117",
+            },
+            &relay,
+        )
+        .unwrap();
+        let selection_blob = signed_selection_blob(relay.selection.as_ref().unwrap()).unwrap();
+        let blob_offset = relay_transcript.len() - selection_blob.len();
+        assert_eq!(relay_transcript[blob_offset - 1], 1);
+        assert_eq!(&relay_transcript[blob_offset..], selection_blob.as_slice());
+        assert_eq!(
+            u32::from_be_bytes(
+                relay_transcript[blob_offset..blob_offset + 4]
+                    .try_into()
+                    .unwrap()
+            ) as usize,
+            selection_transcript(relay.selection.as_ref().unwrap())
+                .unwrap()
+                .len()
+        );
+    }
