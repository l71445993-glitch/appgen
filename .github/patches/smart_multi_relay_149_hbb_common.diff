+                &public_key,
+            )
+            .unwrap();
+        }
+    }
+
+    fn decode_hex<const N: usize>(value: &str) -> [u8; N] {
+        assert_eq!(value.len(), N * 2);
+        let mut result = [0; N];
+        for (index, output) in result.iter_mut().enumerate() {
+            *output = u8::from_str_radix(&value[index * 2..index * 2 + 2], 16).unwrap();
+        }
+        result
+    }
