+pub fn verify_probe_report_signature(
+    report: &SmartRelayProbeReport,
+    device_public_key: &sign::PublicKey,
+) -> Result<(), SmartRelayWireError> {
+    let transcript = probe_report_transcript(report)?;
+    verify_transcript(&transcript, &report.client_signature, device_public_key)
+}
+
+pub fn verify_selection_signature(
+    selection: &SmartRelaySelection,
+    hbbs_public_key: &sign::PublicKey,
+) -> Result<(), SmartRelayWireError> {
+    let transcript = selection_transcript(selection)?;
+    verify_transcript(&transcript, &selection.server_signature, hbbs_public_key)
+}
+
+pub fn verify_capability_response_signature(
+    response: &SmartRelayCapabilityResponse,
+    hbbs_public_key: &sign::PublicKey,
+) -> Result<(), SmartRelayWireError> {
+    let transcript = capability_response_transcript(response)?;
+    verify_transcript(&transcript, &response.server_signature, hbbs_public_key)
+}
+
+pub fn validate_probe_report_for_request(
+    report: &SmartRelayProbeReport,
+    request: &SmartRelayProbeRequest,
+) -> Result<(), SmartRelayWireError> {
+    validate_probe_request(request)?;
+    validate_probe_report(report)?;
+    require_length(&request.server_signature, 64, "server signature")?;
+    require_length(&report.client_signature, 64, "client signature")?;
+    if report.probe_id != request.probe_id
+        || report.role_nonce != request.role_nonce
+        || report.candidate_set_hash != request.candidate_set_hash
+        || report.role.value() != request.role.value()
+    {
+        return Err(SmartRelayWireError::ContextMismatch);
+    }
+    if request.purpose.value() == SmartRelayProbePurpose::SMART_SESSION as i32 {
+        let expected_client_id = match request.role.value() {
+            role if role == SmartRelayPeerRole::SMART_REQUESTER as i32 => {
+                request.requester_id.as_str()
+            }
+            role if role == SmartRelayPeerRole::SMART_TARGET as i32 => request.target_id.as_str(),
+            _ => return Err(SmartRelayWireError::ContextMismatch),
+        };
+        if report.client_id != expected_client_id {
+            return Err(SmartRelayWireError::ContextMismatch);
+        }
+    }
+    let candidates: HashSet<[u8; 16]> = request
+        .candidates
+        .iter()
+        .map(|candidate| fixed_array(&candidate.node_id, "candidate node_id"))
+        .collect::<Result<_, _>>()?;
+    for result in &report.results {
+        if !candidates.contains(&fixed_array(&result.node_id, "result node_id")?) {
+            return Err(SmartRelayWireError::ContextMismatch);
+        }
+    }
+    Ok(())
+}
+
+fn decode_message<M>(bytes: &[u8]) -> Result<M, SmartRelayWireError>
+where
+    M: Message + Default,
+{
+    if bytes.len() > SMART_RELAY_MAX_WIRE_BYTES {
+        return Err(SmartRelayWireError::MessageTooLarge);
+    }
+    M::parse_from_bytes(bytes).map_err(|_| SmartRelayWireError::Protobuf)
+}
+
+fn validate_capability(capability: &SmartRelayCapability) -> Result<(), SmartRelayWireError> {
+    reject_unknown(capability, "SmartRelayCapability")?;
+    if capability.min_protocol == 0
+        || capability.max_protocol < capability.min_protocol
+        || capability.min_protocol > SMART_RELAY_PROTOCOL_V1
+        || capability.max_protocol < SMART_RELAY_PROTOCOL_V1
+    {
+        return Err(SmartRelayWireError::UnsupportedVersion);
+    }
+    if !(1..=SMART_RELAY_MAX_CANDIDATES as u32).contains(&capability.max_candidates) {
+        return Err(SmartRelayWireError::InvalidValue("max_candidates"));
+    }
+    require_length(&capability.client_nonce, 16, "client_nonce")?;
+    if capability.issued_at_ms == 0 {
+        return Err(SmartRelayWireError::InvalidValue("issued_at_ms"));
+    }
+    validate_signature_slot(&capability.signature, "capability signature")
+}
+
+fn validate_capability_request(
+    request: &SmartRelayCapabilityRequest,
+) -> Result<(), SmartRelayWireError> {
+    reject_unknown(request, "SmartRelayCapabilityRequest")?;
+    require_length(&request.nonce, 16, "capability nonce")?;
+    if request.max_protocol < SMART_RELAY_PROTOCOL_V1 {
+        return Err(SmartRelayWireError::UnsupportedVersion);
+    }
+    Ok(())
+}
+
+fn validate_capability_response(
+    response: &SmartRelayCapabilityResponse,
+) -> Result<(), SmartRelayWireError> {
+    reject_unknown(response, "SmartRelayCapabilityResponse")?;
+    require_length(&response.nonce, 16, "capability nonce")?;
+    if response.min_protocol == 0
+        || response.max_protocol < response.min_protocol
+        || response.min_protocol > SMART_RELAY_PROTOCOL_V1
+        || response.max_protocol < SMART_RELAY_PROTOCOL_V1
+    {
+        return Err(SmartRelayWireError::UnsupportedVersion);
+    }
+    validate_ascii_printable(
+        &response.server_build,
+        SMART_RELAY_MAX_SERVER_BUILD_BYTES,
+        false,
+        "server_build",
+    )?;
+    validate_signature_slot(&response.server_signature, "server signature")
+}
+
+fn validate_connect_offer_core(offer: &SmartRelayConnectOffer) -> Result<(), SmartRelayWireError> {
+    reject_unknown(offer, "SmartRelayConnectOffer")?;
+    validate_protocol(offer.protocol_version)?;
+    validate_ascii_token(
+        &offer.requester_id,
+        SMART_RELAY_MAX_ID_BYTES,
+        false,
+        "requester_id",
+    )?;
+    require_length(&offer.request_nonce, 16, "request_nonce")?;
+    if offer.issued_at_ms == 0 {
+        return Err(SmartRelayWireError::InvalidValue("issued_at_ms"));
+    }
+    validate_signature_slot(&offer.signature, "connect signature")
+}
+
+fn validate_probe_request(request: &SmartRelayProbeRequest) -> Result<(), SmartRelayWireError> {
+    reject_unknown(request, "SmartRelayProbeRequest")?;
+    validate_protocol(request.protocol_version)?;
+    require_length(&request.probe_id, 16, "probe_id")?;
+    require_length(&request.role_nonce, 32, "role_nonce")?;
+    require_length(&request.candidate_set_hash, 32, "candidate_set_hash")?;
+    let purpose = request
+        .purpose
+        .enum_value()
+        .map_err(|_| SmartRelayWireError::InvalidEnum("probe purpose"))?;
+    let role = request
+        .role
+        .enum_value()
+        .map_err(|_| SmartRelayWireError::InvalidEnum("peer role"))?;
+    if !matches!(
+        purpose,
+        SmartRelayProbePurpose::SMART_WARMUP | SmartRelayProbePurpose::SMART_SESSION
+    ) || !matches!(
+        role,
+        SmartRelayPeerRole::SMART_REQUESTER | SmartRelayPeerRole::SMART_TARGET
+    ) {
+        return Err(SmartRelayWireError::InvalidEnum("probe context"));
+    }
+    if request.issued_at_ms == 0
+        || request.deadline_ms == 0
+        || request.deadline_ms > SMART_RELAY_MAX_REPORT_CUTOFF_MS
+    {
+        return Err(SmartRelayWireError::InvalidValue("probe deadline"));
+    }
+    validate_candidates(&request.candidates)?;
+    if candidate_set_hash(&request.candidates)?.as_slice() != request.candidate_set_hash.as_ref() {
+        return Err(SmartRelayWireError::ContextMismatch);
+    }
+    validate_signature_slot(&request.server_signature, "server signature")?;
+    if !valid_conn_type(request.conn_type.value()) {
+        return Err(SmartRelayWireError::InvalidEnum("conn_type"));
+    }
+    match purpose {
+        SmartRelayProbePurpose::SMART_WARMUP => {
+            if !request.requester_id.is_empty()
+                || !request.target_id.is_empty()
+                || request.conn_type.value() != ConnType::DEFAULT_CONN as i32
+            {
+                return Err(SmartRelayWireError::ContextMismatch);
+            }
+        }
+        SmartRelayProbePurpose::SMART_SESSION => {
+            validate_ascii_token(
+                &request.target_id,
+                SMART_RELAY_MAX_ID_BYTES,
+                false,
+                "target_id",
+            )?;
+            validate_ascii_token(
+                &request.requester_id,
+                SMART_RELAY_MAX_ID_BYTES,
+                false,
+                "requester_id",
+            )?;
+        }
+        _ => return Err(SmartRelayWireError::InvalidEnum("probe purpose")),
+    }
+    Ok(())
+}
+
+fn validate_probe_report(report: &SmartRelayProbeReport) -> Result<(), SmartRelayWireError> {
+    reject_unknown(report, "SmartRelayProbeReport")?;
+    validate_protocol(report.protocol_version)?;
+    require_length(&report.probe_id, 16, "probe_id")?;
+    require_length(&report.role_nonce, 32, "role_nonce")?;
+    require_length(&report.candidate_set_hash, 32, "candidate_set_hash")?;
+    let role = report
+        .role
+        .enum_value()
+        .map_err(|_| SmartRelayWireError::InvalidEnum("peer role"))?;
+    if !matches!(
+        role,
+        SmartRelayPeerRole::SMART_REQUESTER | SmartRelayPeerRole::SMART_TARGET
+    ) {
+        return Err(SmartRelayWireError::InvalidEnum("peer role"));
+    }
+    validate_ascii_token(
+        &report.client_id,
+        SMART_RELAY_MAX_ID_BYTES,
+        false,
+        "client_id",
+    )?;
+    require_length(&report.network_epoch, 16, "network_epoch")?;
+    if report.results.is_empty() || report.results.len() > SMART_RELAY_MAX_CANDIDATES {
+        return Err(SmartRelayWireError::TooManyCandidates);
+    }
+    let mut node_ids: HashSet<[u8; 16]> = HashSet::with_capacity(report.results.len());
+    for result in &report.results {
+        validate_probe_result(result)?;
+        if !node_ids.insert(fixed_array(&result.node_id, "result node_id")?) {
+            return Err(SmartRelayWireError::DuplicateResult);
+        }
+    }
+    if report.sent_at_ms == 0 {
+        return Err(SmartRelayWireError::InvalidValue("sent_at_ms"));
+    }
+    validate_signature_slot(&report.client_signature, "client signature")
+}
+
+fn validate_probe_result(result: &SmartRelayProbeResult) -> Result<(), SmartRelayWireError> {
+    reject_unknown(result, "SmartRelayProbeResult")?;
+    require_length(&result.node_id, 16, "result node_id")?;
+    let status = result
+        .status
+        .enum_value()
+        .map_err(|_| SmartRelayWireError::InvalidEnum("probe status"))?;
+    if status == SmartRelayProbeStatus::SMART_PROBE_UNSPECIFIED {
+        return Err(SmartRelayWireError::InvalidEnum("probe status"));
+    }
+    if result.rtt_us.len() > SMART_RELAY_MAX_RTT_SAMPLES {
+        return Err(SmartRelayWireError::TooManyRttSamples);
+    }
+    if status == SmartRelayProbeStatus::SMART_PROBE_OK {
+        if result.rtt_us.is_empty()
+            || result
+                .rtt_us
+                .iter()
+                .any(|sample| !(1_000..=3_000_000).contains(sample))
+            || result.sample_age_ms > SMART_RELAY_MAX_SAMPLE_AGE_MS
+        {
+            return Err(SmartRelayWireError::InvalidValue("successful probe result"));
+        }
+    } else if !result.rtt_us.is_empty() || result.sample_age_ms != 0 {
+        return Err(SmartRelayWireError::InvalidValue("failed probe result"));
+    }
+    Ok(())
+}
+
+fn validate_candidates(candidates: &[SmartRelayCandidate]) -> Result<(), SmartRelayWireError> {
+    if candidates.is_empty() || candidates.len() > SMART_RELAY_MAX_CANDIDATES {
+        return Err(SmartRelayWireError::TooManyCandidates);
+    }
+    let mut node_ids: HashSet<[u8; 16]> = HashSet::with_capacity(candidates.len());
+    for candidate in candidates {
+        validate_candidate(candidate)?;
+        if !node_ids.insert(fixed_array(&candidate.node_id, "candidate node_id")?) {
+            return Err(SmartRelayWireError::DuplicateCandidate);
+        }
+    }
+    Ok(())
+}
+
+fn validate_candidate(candidate: &SmartRelayCandidate) -> Result<(), SmartRelayWireError> {
+    reject_unknown(candidate, "SmartRelayCandidate")?;
+    require_length(&candidate.node_id, 16, "candidate node_id")?;
+    let family = candidate
+        .address_family
+        .enum_value()
+        .map_err(|_| SmartRelayWireError::InvalidEnum("address_family"))?;
+    if family != SmartRelayAddressFamily::SMART_AF_IPV4 {
+        return Err(SmartRelayWireError::InvalidEnum("address_family"));
+    }
+    let octets: [u8; 4] = fixed_array(&candidate.address, "candidate IPv4")?;
+    if !is_usable_public_ipv4(Ipv4Addr::from(octets)) {
+        return Err(SmartRelayWireError::InvalidValue("candidate IPv4"));
+    }
+    if !(1..=u16::MAX as u32).contains(&candidate.port) {
+        return Err(SmartRelayWireError::InvalidValue("candidate port"));
+    }
+    if !(SMART_RELAY_MIN_CONNECT_TIMEOUT_MS..=SMART_RELAY_MAX_CONNECT_TIMEOUT_MS)
+        .contains(&candidate.probe_timeout_ms)
+    {
+        return Err(SmartRelayWireError::InvalidValue("probe_timeout_ms"));
+    }
+    Ok(())
+}
+
+fn validate_selection(
+    selection: &SmartRelaySelection,
+    require_signature: bool,
+) -> Result<(), SmartRelayWireError> {
+    reject_unknown(selection, "SmartRelaySelection")?;
+    validate_protocol(selection.protocol_version)?;
+    validate_ascii_token(
+        &selection.requester_id,
+        SMART_RELAY_MAX_ID_BYTES,
+        false,
+        "requester_id",
+    )?;
+    validate_ascii_token(
+        &selection.target_id,
+        SMART_RELAY_MAX_ID_BYTES,
+        false,
+        "target_id",
+    )?;
+    require_length(&selection.node_id, 16, "selection node_id")?;
+    validate_relay_server(&selection.relay_server)?;
+    if selection.expires_at_ms == 0 {
+        return Err(SmartRelayWireError::InvalidValue("expires_at_ms"));
+    }
+    require_length(&selection.origin_request_nonce, 16, "origin_request_nonce")?;
+    if !valid_conn_type(selection.conn_type.value()) {
+        return Err(SmartRelayWireError::InvalidEnum("conn_type"));
+    }
+    let mode = selection
+        .mode
+        .enum_value()
+        .map_err(|_| SmartRelayWireError::InvalidEnum("selection mode"))?;
+    if mode == SmartRelaySelectionMode::SMART_SELECTION_UNSPECIFIED {
+        return Err(SmartRelayWireError::InvalidEnum("selection mode"));
+    }
+    if require_signature {
+        require_length(&selection.server_signature, 64, "server signature")
+    } else {
+        validate_signature_slot(&selection.server_signature, "server signature")
+    }
+}
+
+fn append_candidates(
+    out: &mut Canonical,
+    candidates: &[SmartRelayCandidate],
+) -> Result<(), SmartRelayWireError> {
+    validate_candidates(candidates)?;
+    let mut sorted: Vec<&SmartRelayCandidate> = candidates.iter().collect();
+    sorted.sort_by(|left, right| {
+        left.node_id
+            .as_ref()
+            .cmp(right.node_id.as_ref())
+            .then_with(|| left.address.as_ref().cmp(right.address.as_ref()))
+            .then_with(|| left.port.cmp(&right.port))
+    });
+    out.count(sorted.len())?;
+    for candidate in sorted {
+        out.bytes(&candidate.node_id)?;
+        out.u32(candidate.address_family.value() as u32);
+        out.bytes(&candidate.address)?;
+        out.u32(candidate.port);
+        out.u32(candidate.probe_timeout_ms);
+    }
+    Ok(())
+}
+
+fn append_results(
+    out: &mut Canonical,
+    results: &[SmartRelayProbeResult],
+) -> Result<(), SmartRelayWireError> {
+    if results.is_empty() || results.len() > SMART_RELAY_MAX_CANDIDATES {
+        return Err(SmartRelayWireError::TooManyCandidates);
+    }
+    let mut sorted: Vec<&SmartRelayProbeResult> = results.iter().collect();
+    sorted.sort_by(|left, right| left.node_id.as_ref().cmp(right.node_id.as_ref()));
+    out.count(sorted.len())?;
+    for result in sorted {
+        validate_probe_result(result)?;
+        out.bytes(&result.node_id)?;
+        out.u32(result.status.value() as u32);
+        let mut samples = result.rtt_us.clone();
+        samples.sort_unstable();
+        out.count(samples.len())?;
+        for sample in samples {
+            out.u32(sample);
+        }
+        out.u32(result.sample_age_ms);
+    }
+    Ok(())
+}
+
+fn validate_protocol(version: u32) -> Result<(), SmartRelayWireError> {
+    if version == SMART_RELAY_PROTOCOL_V1 {
+        Ok(())
+    } else {
+        Err(SmartRelayWireError::UnsupportedVersion)
+    }
+}
+
+fn validate_signature_slot(value: &[u8], field: &'static str) -> Result<(), SmartRelayWireError> {
+    if value.is_empty() || value.len() == 64 {
+        Ok(())
+    } else {
+        Err(SmartRelayWireError::InvalidLength(field))
+    }
+}
+
+fn reject_unknown<M: Message>(message: &M, name: &'static str) -> Result<(), SmartRelayWireError> {
+    if message.unknown_fields().iter().next().is_some() {
+        Err(SmartRelayWireError::UnknownFields(name))
+    } else {
+        Ok(())
+    }
+}
+
+fn require_length(
+    value: &[u8],
+    expected: usize,
+    field: &'static str,
+) -> Result<(), SmartRelayWireError> {
+    if value.len() == expected {
+        Ok(())
+    } else {
+        Err(SmartRelayWireError::InvalidLength(field))
+    }
+}
+
+fn fixed_array<const N: usize>(
+    value: &[u8],
+    field: &'static str,
+) -> Result<[u8; N], SmartRelayWireError> {
+    value
+        .try_into()
+        .map_err(|_| SmartRelayWireError::InvalidLength(field))
+}
+
+fn validate_ascii_token(
+    value: &str,
+    maximum: usize,
+    allow_empty: bool,
+    field: &'static str,
+) -> Result<(), SmartRelayWireError> {
+    if value.len() > maximum
+        || (!allow_empty && value.is_empty())
+        || !value.is_ascii()
+        || value.bytes().any(|byte| !(0x21..=0x7e).contains(&byte))
+    {
+        Err(SmartRelayWireError::InvalidAscii(field))
+    } else {
+        Ok(())
+    }
+}
+
+fn validate_ascii_printable(
+    value: &str,
+    maximum: usize,
+    allow_empty: bool,
+    field: &'static str,
+) -> Result<(), SmartRelayWireError> {
+    if value.len() > maximum
+        || (!allow_empty && value.is_empty())
+        || !value.is_ascii()
+        || value.bytes().any(|byte| !(0x20..=0x7e).contains(&byte))
+    {
+        Err(SmartRelayWireError::InvalidAscii(field))
+    } else {
+        Ok(())
+    }
+}
+
+fn validate_relay_server(value: &str) -> Result<(), SmartRelayWireError> {
+    if value.len() > SMART_RELAY_MAX_RELAY_SERVER_BYTES {
+        return Err(SmartRelayWireError::InvalidLength("relay_server"));
+    }
+    let address = SocketAddrV4::from_str(value)
+        .map_err(|_| SmartRelayWireError::InvalidValue("relay_server"))?;
+    if address.to_string() != value || !is_usable_public_ipv4(*address.ip()) {
+        return Err(SmartRelayWireError::InvalidValue("relay_server"));
+    }
+    Ok(())
+}
+
+fn valid_conn_type(value: i32) -> bool {
+    (ConnType::DEFAULT_CONN as i32..=ConnType::TERMINAL as i32).contains(&value)
+}
+
+pub fn is_usable_public_ipv4(address: Ipv4Addr) -> bool {
+    let [a, b, c, d] = address.octets();
+    if a == 0
+        || a == 10
+        || a == 127
+        || a >= 224
+        || (a == 100 && (64..=127).contains(&b))
+        || (a == 169 && b == 254)
+        || (a == 172 && (16..=31).contains(&b))
+        || (a == 192 && b == 168)
+        || (a == 192 && b == 0 && c == 2)
+        || (a == 192 && b == 88 && c == 99)
+        || (a == 198 && (b == 18 || b == 19))
+        || (a == 198 && b == 51 && c == 100)
+        || (a == 203 && b == 0 && c == 113)
+    {
+        return false;
+    }
+    if a == 192 && b == 0 && c == 0 {
+        return matches!(d, 9 | 10);
+    }
+    true
+}
+
+struct Canonical {
+    bytes: Vec<u8>,
+}
+
+impl Canonical {
+    fn new(domain: &[u8]) -> Self {
+        let mut bytes = Vec::with_capacity(256);
+        bytes.extend_from_slice(domain);
+        bytes.push(0);
+        Self { bytes }
+    }
+
+    fn empty() -> Self {
+        Self {
+            bytes: Vec::with_capacity(256),
+        }
+    }
+
+    fn u32(&mut self, value: u32) {
+        self.bytes.extend_from_slice(&value.to_be_bytes());
+    }
+
+    fn u64(&mut self, value: u64) {
+        self.bytes.extend_from_slice(&value.to_be_bytes());
+    }
+
+    fn boolean(&mut self, value: bool) {
+        self.bytes.push(u8::from(value));
+    }
+
+    fn count(&mut self, value: usize) -> Result<(), SmartRelayWireError> {
+        let value = u32::try_from(value)
+            .map_err(|_| SmartRelayWireError::InvalidLength("canonical list"))?;
+        self.u32(value);
+        Ok(())
+    }
+
+    fn bytes(&mut self, value: &[u8]) -> Result<(), SmartRelayWireError> {
+        append_len(&mut self.bytes, value.len())?;
+        self.bytes.extend_from_slice(value);
+        Ok(())
+    }
+
+    fn raw(&mut self, value: &[u8]) {
+        self.bytes.extend_from_slice(value);
+    }
+
+    fn string(&mut self, value: &str) -> Result<(), SmartRelayWireError> {
+        self.bytes(value.as_bytes())
+    }
+
+    fn optional_bytes(&mut self, value: Option<&[u8]>) -> Result<(), SmartRelayWireError> {
+        match value {
+            Some(value) => {
+                self.boolean(true);
+                self.bytes(value)
+            }
+            None => {
+                self.boolean(false);
+                Ok(())
+            }
+        }
+    }
+
+    fn finish(self) -> Result<Vec<u8>, SmartRelayWireError> {
+        if self.bytes.len() > SMART_RELAY_MAX_WIRE_BYTES {
+            Err(SmartRelayWireError::MessageTooLarge)
+        } else {
+            Ok(self.bytes)
+        }
+    }
+}
+
+fn append_len(bytes: &mut Vec<u8>, length: usize) -> Result<(), SmartRelayWireError> {
+    let length =
+        u32::try_from(length).map_err(|_| SmartRelayWireError::InvalidLength("canonical value"))?;
+    bytes.extend_from_slice(&length.to_be_bytes());
+    Ok(())
+}
