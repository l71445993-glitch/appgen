diff --git a/src/smart_relay.rs b/src/smart_relay.rs
new file mode 100644
index 0000000000000000000000000000000000000000..b55c11f0b4a747fd4fbb3b943864d9088a0c8249
--- /dev/null
+++ b/src/smart_relay.rs
@@ -0,0 +1,1646 @@
+use crate::rendezvous_proto::{
+    ConnType, SmartRelayAddressFamily, SmartRelayCandidate, SmartRelayCapability,
+    SmartRelayCapabilityRequest, SmartRelayCapabilityResponse, SmartRelayConnectOffer,
+    SmartRelayPeerRole, SmartRelayProbePurpose, SmartRelayProbeReport, SmartRelayProbeRequest,
+    SmartRelayProbeResult, SmartRelayProbeStatus, SmartRelaySelection, SmartRelaySelectionMode,
+};
+use protobuf::Message;
+use sha2::{Digest, Sha256};
+use sodiumoxide::crypto::sign;
+use std::{
+    collections::HashSet,
+    convert::{TryFrom, TryInto},
+    net::{Ipv4Addr, SocketAddrV4},
+    str::FromStr,
+};
+use thiserror::Error;
+
+pub const SMART_RELAY_PROTOCOL_V1: u32 = 1;
+pub const SMART_RELAY_MAX_WIRE_BYTES: usize = 4 * 1024;
+pub const SMART_RELAY_MAX_CANDIDATES: usize = 6;
+pub const SMART_RELAY_MAX_RTT_SAMPLES: usize = 3;
+pub const SMART_RELAY_MAX_ID_BYTES: usize = 64;
+pub const SMART_RELAY_MAX_RELAY_SERVER_BYTES: usize = 64;
+pub const SMART_RELAY_MAX_SERVER_BUILD_BYTES: usize = 64;
+pub const SMART_RELAY_MAX_SAMPLE_AGE_MS: u32 = 30 * 60 * 1000;
+pub const SMART_RELAY_MAX_REPORT_CUTOFF_MS: u32 = 2_000;
+pub const SMART_RELAY_MIN_CONNECT_TIMEOUT_MS: u32 = 200;
+pub const SMART_RELAY_MAX_CONNECT_TIMEOUT_MS: u32 = 1_500;
+pub const SMART_RELAY_FEATURE_TCP_CONNECT_PROBE: u64 = 1 << 0;
+pub const SMART_RELAY_FEATURE_SIGNED_REPORT: u64 = 1 << 1;
+pub const SMART_RELAY_FEATURE_NETWORK_EPOCH_CACHE: u64 = 1 << 2;
+pub const SMART_RELAY_FEATURE_SIGNED_SELECTION_REUSE: u64 = 1 << 3;
+pub const SMART_RELAY_REQUIRED_SESSION_FEATURES: u64 = SMART_RELAY_FEATURE_TCP_CONNECT_PROBE
+    | SMART_RELAY_FEATURE_SIGNED_REPORT
+    | SMART_RELAY_FEATURE_SIGNED_SELECTION_REUSE;
+
+const DOMAIN_CAPABILITY: &[u8] = b"RDSMART/CAPABILITY/V1";
+const DOMAIN_CONNECT_PUNCH: &[u8] = b"RDSMART/CONNECT/PUNCH/V1";
+const DOMAIN_CONNECT_RELAY: &[u8] = b"RDSMART/CONNECT/RELAY/V1";
+const DOMAIN_PROBE_REQUEST: &[u8] = b"RDSMART/PROBE-REQUEST/V1";
+const DOMAIN_PROBE_REPORT: &[u8] = b"RDSMART/PROBE-REPORT/V1";
+const DOMAIN_SELECTION: &[u8] = b"RDSMART/SELECTION/V1";
+const DOMAIN_CAPABILITY_RESPONSE: &[u8] = b"RDSMART/CAPABILITY-RESPONSE/V1";
+
+#[derive(Debug, Error, Clone, PartialEq, Eq)]
+pub enum SmartRelayWireError {
+    #[error("smart relay message exceeds the 4 KiB limit")]
+    MessageTooLarge,
+    #[error("smart relay protobuf decoding failed")]
+    Protobuf,
+    #[error("unknown protobuf fields in {0}")]
+    UnknownFields(&'static str),
+    #[error("unsupported smart relay protocol version")]
+    UnsupportedVersion,
+    #[error("invalid length for {0}")]
+    InvalidLength(&'static str),
+    #[error("invalid ASCII value for {0}")]
+    InvalidAscii(&'static str),
+    #[error("unknown or invalid enum value for {0}")]
+    InvalidEnum(&'static str),
+    #[error("invalid value for {0}")]
+    InvalidValue(&'static str),
+    #[error("too many smart relay candidates")]
+    TooManyCandidates,
+    #[error("duplicate smart relay candidate")]
+    DuplicateCandidate,
+    #[error("too many RTT samples")]
+    TooManyRttSamples,
+    #[error("duplicate smart relay probe result")]
+    DuplicateResult,
+    #[error("smart relay signed context does not match its outer message")]
+    ContextMismatch,
+    #[error("smart relay signature verification failed")]
+    InvalidSignature,
+}
+
+#[derive(Clone, Copy)]
+pub struct CapabilityTranscriptContext<'a> {
+    pub hbbs_key_fingerprint: &'a [u8; 32],
+    pub outer_peer_id: &'a str,
+    pub register_pk_public_key: Option<&'a [u8]>,
+}
+
+#[derive(Clone, Copy)]
+pub struct PunchConnectTranscriptContext<'a> {
+    pub hbbs_key_fingerprint: &'a [u8; 32],
+    pub requester_id: &'a str,
+    pub target_id: &'a str,
+    pub conn_type: ConnType,
+    pub force_relay: bool,
+}
+
+#[derive(Clone, Copy)]
+pub struct RelayConnectTranscriptContext<'a> {
+    pub hbbs_key_fingerprint: &'a [u8; 32],
+    pub requester_id: &'a str,
+    pub target_id: &'a str,
+    pub conn_type: ConnType,
+    pub secure: bool,
+    pub relay_attempt_uuid: &'a str,
+    pub relay_server: &'a str,
+}
+
+pub fn hbbs_key_fingerprint(raw_public_key: &[u8]) -> Result<[u8; 32], SmartRelayWireError> {
+    require_length(raw_public_key, 32, "hbbs public key")?;
+    Ok(Sha256::digest(raw_public_key).into())
+}
+
+pub fn supports_smart_session(capability: &SmartRelayCapability) -> bool {
+    capability.min_protocol <= SMART_RELAY_PROTOCOL_V1
+        && capability.max_protocol >= SMART_RELAY_PROTOCOL_V1
+        && capability.feature_bits & SMART_RELAY_REQUIRED_SESSION_FEATURES
+            == SMART_RELAY_REQUIRED_SESSION_FEATURES
+        && (1..=SMART_RELAY_MAX_CANDIDATES as u32).contains(&capability.max_candidates)
+}
+
+pub fn decode_capability(bytes: &[u8]) -> Result<SmartRelayCapability, SmartRelayWireError> {
+    let message = decode_message::<SmartRelayCapability>(bytes)?;
+    validate_capability(&message)?;
+    require_length(&message.signature, 64, "capability signature")?;
+    Ok(message)
+}
+
+pub fn decode_selection(bytes: &[u8]) -> Result<SmartRelaySelection, SmartRelayWireError> {
+    let message = decode_message::<SmartRelaySelection>(bytes)?;
+    validate_selection(&message, true)?;
+    Ok(message)
+}
+
+pub fn decode_connect_offer(bytes: &[u8]) -> Result<SmartRelayConnectOffer, SmartRelayWireError> {
+    let message = decode_message::<SmartRelayConnectOffer>(bytes)?;
+    reject_unknown(&message, "SmartRelayConnectOffer")?;
+    validate_protocol(message.protocol_version)?;
+    validate_ascii_token(
+        &message.requester_id,
+        SMART_RELAY_MAX_ID_BYTES,
+        false,
+        "requester_id",
+    )?;
+    require_length(&message.request_nonce, 16, "request_nonce")?;
+    if message.issued_at_ms == 0 {
+        return Err(SmartRelayWireError::InvalidValue("issued_at_ms"));
+    }
+    validate_signature_slot(&message.signature, "connect signature")?;
+    require_length(&message.signature, 64, "connect signature")?;
+    if let Some(selection) = message.selection.as_ref() {
+        validate_selection(selection, true)?;
+    }
+    Ok(message)
+}
+
+pub fn decode_probe_request(bytes: &[u8]) -> Result<SmartRelayProbeRequest, SmartRelayWireError> {
+    let message = decode_message::<SmartRelayProbeRequest>(bytes)?;
+    validate_probe_request(&message)?;
+    require_length(&message.server_signature, 64, "server signature")?;
+    Ok(message)
+}
+
+pub fn decode_probe_report(bytes: &[u8]) -> Result<SmartRelayProbeReport, SmartRelayWireError> {
+    let message = decode_message::<SmartRelayProbeReport>(bytes)?;
+    validate_probe_report(&message)?;
+    require_length(&message.client_signature, 64, "client signature")?;
+    Ok(message)
+}
+
+pub fn decode_capability_request(
+    bytes: &[u8],
+) -> Result<SmartRelayCapabilityRequest, SmartRelayWireError> {
+    let message = decode_message::<SmartRelayCapabilityRequest>(bytes)?;
+    validate_capability_request(&message)?;
+    Ok(message)
+}
+
+pub fn decode_capability_response(
+    bytes: &[u8],
+) -> Result<SmartRelayCapabilityResponse, SmartRelayWireError> {
+    let message = decode_message::<SmartRelayCapabilityResponse>(bytes)?;
+    validate_capability_response(&message)?;
+    require_length(&message.server_signature, 64, "server signature")?;
+    Ok(message)
+}
+
+pub fn capability_transcript(
+    context: CapabilityTranscriptContext<'_>,
+    capability: &SmartRelayCapability,
+) -> Result<Vec<u8>, SmartRelayWireError> {
+    validate_capability(capability)?;
+    validate_ascii_token(
+        context.outer_peer_id,
+        SMART_RELAY_MAX_ID_BYTES,
+        false,
+        "outer peer id",
+    )?;
+    if let Some(public_key) = context.register_pk_public_key {
+        require_length(public_key, 32, "RegisterPk public key")?;
+    }
+    let mut out = Canonical::new(DOMAIN_CAPABILITY);
+    out.bytes(context.hbbs_key_fingerprint)?;
+    out.string(context.outer_peer_id)?;
+    out.optional_bytes(context.register_pk_public_key)?;
+    out.u32(capability.min_protocol);
+    out.u32(capability.max_protocol);
+    out.u64(capability.feature_bits);
+    out.u32(capability.max_candidates);
+    out.bytes(&capability.client_nonce)?;
+    out.u64(capability.issued_at_ms);
+    out.finish()
+}
+
+pub fn punch_connect_transcript(
+    context: PunchConnectTranscriptContext<'_>,
+    offer: &SmartRelayConnectOffer,
+) -> Result<Vec<u8>, SmartRelayWireError> {
+    validate_connect_offer_core(offer)?;
+    if offer.selection.is_some()
+        || offer.requester_id != context.requester_id
+        || !valid_conn_type(context.conn_type as i32)
+    {
+        return Err(SmartRelayWireError::ContextMismatch);
+    }
+    validate_ascii_token(
+        context.target_id,
+        SMART_RELAY_MAX_ID_BYTES,
+        false,
+        "target_id",
+    )?;
+    let mut out = Canonical::new(DOMAIN_CONNECT_PUNCH);
+    out.bytes(context.hbbs_key_fingerprint)?;
+    out.string(context.requester_id)?;
+    out.string(context.target_id)?;
+    out.u32(context.conn_type as u32);
+    out.boolean(context.force_relay);
+    out.bytes(&offer.request_nonce)?;
+    out.u64(offer.issued_at_ms);
+    out.boolean(false);
+    out.finish()
+}
+
+pub fn relay_connect_transcript(
+    context: RelayConnectTranscriptContext<'_>,
+    offer: &SmartRelayConnectOffer,
+) -> Result<Vec<u8>, SmartRelayWireError> {
+    validate_connect_offer_core(offer)?;
+    validate_ascii_token(
+        context.target_id,
+        SMART_RELAY_MAX_ID_BYTES,
+        false,
+        "target_id",
+    )?;
+    validate_ascii_token(
+        context.relay_attempt_uuid,
+        SMART_RELAY_MAX_ID_BYTES,
+        false,
+        "relay attempt UUID",
+    )?;
+    validate_relay_server(context.relay_server)?;
+    if offer.requester_id != context.requester_id || !valid_conn_type(context.conn_type as i32) {
+        return Err(SmartRelayWireError::ContextMismatch);
+    }
+    let selection = offer
+        .selection
+        .as_ref()
+        .ok_or(SmartRelayWireError::ContextMismatch)?;
+    validate_selection(selection, true)?;
+    if selection.requester_id != context.requester_id
+        || selection.target_id != context.target_id
+        || selection.conn_type.value() != context.conn_type as i32
+        || selection.relay_server != context.relay_server
+        || selection.origin_request_nonce.as_ref() != offer.request_nonce.as_ref()
+    {
+        return Err(SmartRelayWireError::ContextMismatch);
+    }
+    let blob = signed_selection_blob(selection)?;
+    let mut out = Canonical::new(DOMAIN_CONNECT_RELAY);
+    out.bytes(context.hbbs_key_fingerprint)?;
+    out.string(context.requester_id)?;
+    out.string(context.target_id)?;
+    out.u32(context.conn_type as u32);
+    out.boolean(context.secure);
+    out.string(context.relay_attempt_uuid)?;
+    out.string(context.relay_server)?;
+    out.bytes(&offer.request_nonce)?;
+    out.u64(offer.issued_at_ms);
+    out.boolean(true);
+    out.raw(&blob);
+    out.finish()
+}
+
+pub fn probe_request_transcript(
+    request: &SmartRelayProbeRequest,
+) -> Result<Vec<u8>, SmartRelayWireError> {
+    validate_probe_request(request)?;
+    let mut out = Canonical::new(DOMAIN_PROBE_REQUEST);
+    out.u32(request.protocol_version);
+    out.bytes(&request.probe_id)?;
+    out.bytes(&request.role_nonce)?;
+    out.bytes(&request.candidate_set_hash)?;
+    out.u32(request.purpose.value() as u32);
+    out.u32(request.role.value() as u32);
+    out.u64(request.issued_at_ms);
+    out.u32(request.deadline_ms);
+    append_candidates(&mut out, &request.candidates)?;
+    out.string(&request.requester_id)?;
+    out.string(&request.target_id)?;
+    out.u32(request.conn_type.value() as u32);
+    out.finish()
+}
+
+pub fn probe_report_transcript(
+    report: &SmartRelayProbeReport,
+) -> Result<Vec<u8>, SmartRelayWireError> {
+    validate_probe_report(report)?;
+    let mut out = Canonical::new(DOMAIN_PROBE_REPORT);
+    out.u32(report.protocol_version);
+    out.bytes(&report.probe_id)?;
+    out.bytes(&report.role_nonce)?;
+    out.bytes(&report.candidate_set_hash)?;
+    out.u32(report.role.value() as u32);
+    out.string(&report.client_id)?;
+    out.bytes(&report.network_epoch)?;
+    append_results(&mut out, &report.results)?;
+    out.u64(report.sent_at_ms);
+    out.finish()
+}
+
+pub fn selection_transcript(
+    selection: &SmartRelaySelection,
+) -> Result<Vec<u8>, SmartRelayWireError> {
+    validate_selection(selection, false)?;
+    let mut out = Canonical::new(DOMAIN_SELECTION);
+    out.u32(selection.protocol_version);
+    out.string(&selection.requester_id)?;
+    out.string(&selection.target_id)?;
+    out.bytes(&selection.node_id)?;
+    out.string(&selection.relay_server)?;
+    out.u64(selection.expires_at_ms);
+    out.bytes(&selection.origin_request_nonce)?;
+    out.u32(selection.conn_type.value() as u32);
+    out.u32(selection.mode.value() as u32);
+    out.finish()
+}
+
+pub fn capability_response_transcript(
+    response: &SmartRelayCapabilityResponse,
+) -> Result<Vec<u8>, SmartRelayWireError> {
+    validate_capability_response(response)?;
+    let mut out = Canonical::new(DOMAIN_CAPABILITY_RESPONSE);
+    out.bytes(&response.nonce)?;
+    out.u32(response.min_protocol);
+    out.u32(response.max_protocol);
+    out.string(&response.server_build)?;
+    out.u64(response.feature_bits);
+    out.finish()
+}
+
+pub fn candidate_set_hash(
+    candidates: &[SmartRelayCandidate],
+) -> Result<[u8; 32], SmartRelayWireError> {
+    let mut out = Canonical::empty();
+    append_candidates(&mut out, candidates)?;
+    Ok(Sha256::digest(out.finish()?).into())
+}
+
+pub fn signed_selection_blob(
+    selection: &SmartRelaySelection,
+) -> Result<Vec<u8>, SmartRelayWireError> {
+    validate_selection(selection, true)?;
+    let transcript = selection_transcript(selection)?;
+    let mut blob = Vec::with_capacity(4 + transcript.len() + 4 + 64);
+    append_len(&mut blob, transcript.len())?;
+    blob.extend_from_slice(&transcript);
+    append_len(&mut blob, selection.server_signature.len())?;
+    blob.extend_from_slice(&selection.server_signature);
+    if blob.len() > SMART_RELAY_MAX_WIRE_BYTES {
+        return Err(SmartRelayWireError::MessageTooLarge);
+    }
+    Ok(blob)
+}
+
+pub fn sign_transcript(transcript: &[u8], secret_key: &sign::SecretKey) -> [u8; 64] {
+    sign::sign_detached(transcript, secret_key).to_bytes()
+}
+
+pub fn verify_transcript(
+    transcript: &[u8],
+    signature: &[u8],
+    public_key: &sign::PublicKey,
+) -> Result<(), SmartRelayWireError> {
+    require_length(signature, 64, "signature")?;
+    let signature = sign::Signature::from_bytes(signature)
+        .map_err(|_| SmartRelayWireError::InvalidSignature)?;
+    if sign::verify_detached(&signature, transcript, public_key) {
+        Ok(())
+    } else {
+        Err(SmartRelayWireError::InvalidSignature)
+    }
+}
+
+pub fn verify_capability_signature(
+    context: CapabilityTranscriptContext<'_>,
+    capability: &SmartRelayCapability,
+    device_public_key: &sign::PublicKey,
+) -> Result<(), SmartRelayWireError> {
+    let transcript = capability_transcript(context, capability)?;
+    verify_transcript(&transcript, &capability.signature, device_public_key)
+}
+
+pub fn verify_punch_connect_signature(
+    context: PunchConnectTranscriptContext<'_>,
+    offer: &SmartRelayConnectOffer,
+    device_public_key: &sign::PublicKey,
+) -> Result<(), SmartRelayWireError> {
+    let transcript = punch_connect_transcript(context, offer)?;
+    verify_transcript(&transcript, &offer.signature, device_public_key)
+}
+
+pub fn verify_relay_connect_signatures(
+    context: RelayConnectTranscriptContext<'_>,
+    offer: &SmartRelayConnectOffer,
+    device_public_key: &sign::PublicKey,
+    hbbs_public_key: &sign::PublicKey,
+) -> Result<(), SmartRelayWireError> {
+    let transcript = relay_connect_transcript(context, offer)?;
+    let selection = offer
+        .selection
+        .as_ref()
+        .ok_or(SmartRelayWireError::ContextMismatch)?;
+    verify_selection_signature(selection, hbbs_public_key)?;
+    verify_transcript(&transcript, &offer.signature, device_public_key)
+}
+
+pub fn verify_probe_request_signature(
+    request: &SmartRelayProbeRequest,
+    hbbs_public_key: &sign::PublicKey,
+) -> Result<(), SmartRelayWireError> {
