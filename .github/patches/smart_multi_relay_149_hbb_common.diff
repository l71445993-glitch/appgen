+        sodiumoxide::init().unwrap();
+        let public_key = sign::PublicKey::from_slice(&decode_hex::<32>(PUBLIC_KEY)).unwrap();
+        for ((name, transcript), (expected_name, expected_hash, expected_signature)) in
+            golden_transcripts().into_iter().zip(GOLDEN)
+        {
+            assert_eq!(name, expected_name);
+            let hash: [u8; 32] = Sha256::digest(&transcript).into();
+            assert_eq!(hash, decode_hex::<32>(expected_hash), "{} hash", name);
+            verify_transcript(
+                &transcript,
